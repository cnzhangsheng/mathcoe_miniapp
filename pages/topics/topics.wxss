/* pages/topics/topics.wxss - 100%复刻 kangaroo-math-brain */

.topics-container {
  padding: 32rpx;
  padding-bottom: 192rpx;
  background-color: #F8F8F8;
  min-height: 100vh;
}

.loading-state {
  text-align: center;
  padding: 100rpx;
  color: rgba(0,0,0,0.4);
}

/* ============ 学习复盘 ============ */
.insight-card {
  background: linear-gradient(135deg, #059669 0%, #10B981 100%);
  border-radius: 64rpx;
  padding: 48rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.insight-decorator {
  position: absolute;
  right: -10%;
  top: -10%;
  width: 256rpx;
  height: 256rpx;
  background-color: rgba(255,255,255,0.1);
  border-radius: 50%;
  filter: blur(48rpx);
}

.insight-content {
  position: relative;
  z-index: 1;
}

.insight-header {
  margin-bottom: 16rpx;
}

.insight-icon-box {
  width: 64rpx;
  height: 64rpx;
  background-color: rgba(255,255,255,0.2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.insight-title {
  color: rgba(255,255,255,0.8);
  letter-spacing: 2rpx;
}

.insight-message {
  margin-bottom: 16rpx;
  font-size: 15px;
  line-height: 1.5;
}

.highlight {
  color: #FBBF24;
}

.insight-footer {
  gap: 32rpx;
}

.insight-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  background-color: rgba(255,255,255,0.1);
  border-radius: 32rpx;
}

.insight-sub {
  color: rgba(255,255,255,0.5);
}

.login-insight-btn {
  display: inline-flex;
  padding: 16rpx 40rpx;
  background-color: rgba(255,255,255,0.2);
  border-radius: 32rpx;
}

.login-insight-btn-text {
  color: #fff;
  font-size: 28rpx;
}

/* ============ Section Header ============ */
.section-header {
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 16rpx;
}

.section-title {
  font-size: 15px;
  color: rgba(0,0,0,0.8);
}

/* Tab Group */
.tab-group {
  display: flex;
  gap: 12rpx;
  background-color: rgba(0,0,0,0.05);
  padding: 8rpx;
  border-radius: 24rpx;
}

.tab-item {
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
}

.tab-item.active {
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.tab-text {
  color: rgba(0,0,0,0.4);
}

.tab-item.active .tab-text {
  color: rgba(0,0,0,1);
}

/* ============ Topics Grid (3 columns) ============ */
.topics-section {
  margin-bottom: 32rpx;
}

.topics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.topic-card {
  background-color: #fff;
  padding: 16rpx 12rpx;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  border: 2rpx solid rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 10rpx;
}

.topic-icon-box {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.topic-icon {
  font-size: 28px;
}

.topic-icon-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
}

/* 颜色映射 */
.bg-blue {
  background-color: rgba(59,130,246,0.1);
  color: #3B82F6;
}

.bg-purple {
  background-color: rgba(168,85,247,0.1);
  color: #A855F7;
}

.bg-emerald {
  background-color: rgba(16,185,129,0.1);
  color: #10B881;
}

.bg-amber {
  background-color: rgba(251,191,36,0.1);
  color: #FBBF24;
}

.bg-rose {
  background-color: rgba(244,63,94,0.1);
  color: #F43F5E;
}

/* 卡片背景色 */
.card-bg-blue {
  background-color: rgba(59,130,246,0.12);
}

.card-bg-purple {
  background-color: rgba(168,85,247,0.12);
}

.card-bg-emerald {
  background-color: rgba(16,185,129,0.12);
}

.card-bg-amber {
  background-color: rgba(251,191,36,0.12);
}

.card-bg-rose {
  background-color: rgba(244,63,94,0.12);
}

.topic-info {
  width: 100%;
}

.topic-title {
  display: block;
  margin-bottom: 8rpx;
  color: rgba(0,0,0,0.9);
}

.topic-progress-bar {
  width: 100%;
  height: 6rpx;
  background-color: rgba(0,0,0,0.05);
  border-radius: 6rpx;
  overflow: hidden;
}

.topic-progress-fill {
  height: 100%;
  border-radius: 6rpx;
}

.progress-blue {
  background-color: #3B82F6;
}

.progress-purple {
  background-color: #A855F7;
}

.progress-emerald {
  background-color: #059669;
}

.progress-amber {
  background-color: #FBBF24;
}

.progress-rose {
  background-color: #F43F5E;
}

/* ============ 推荐题目卡片 ============ */
.recommend-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  background: linear-gradient(135deg, rgba(99,102,241,0.08), rgba(99,102,241,0.03));
  border-radius: 48rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid rgba(99,102,241,0.15);
}

.recommend-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.recommend-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background-color: rgba(99,102,241,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.recommend-icon {
  font-size: 40rpx;
}

.recommend-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.recommend-title {
  font-size: 28rpx;
  color: #6366F1;
}

.recommend-sub {
  color: rgba(99,102,241,0.5);
}

.recommend-arrow {
  font-size: 36rpx;
  color: rgba(99,102,241,0.3);
}

/* ============ 推荐题目列表（已登录） ============ */
.recommend-section {
  margin-bottom: 32rpx;
}

.recommend-topic-label {
  font-size: 22rpx;
  color: rgba(0,0,0,0.3);
}

.recommend-loading {
  text-align: center;
  padding: 48rpx;
  color: rgba(0,0,0,0.3);
  font-size: 24rpx;
}

.recommend-card-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.question-card {
  background-color: #fff;
  padding: 32rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  border: 2rpx solid rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.question-card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.question-card-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #6366F1;
}

.q-type-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.q-type-badge.topic-yunsuan {
  background-color: #FFF0D6;
  color: #FF8A00;
}
.q-type-badge.topic-luoji {
  background-color: #DCFFE4;
  color: #10B981;
}
.q-type-badge.topic-tuxing {
  background-color: #FFE8EC;
  color: #FF6B8A;
}
.q-type-badge.topic-yingyong {
  background-color: #E0F7E9;
  color: #38D9A9;
}
.q-type-badge.topic-default {
  background-color: #FFF5F5;
  color: #FF8787;
}

.q-diff-badge {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  background-color: #FEF3C7;
  color: #D97706;
}

.question-card-body {
  min-height: 0;
}

.question-card-text {
  font-size: 26rpx;
  color: rgba(0,0,0,0.85);
  line-height: 1.6;
  word-break: break-word;
}


.recommend-footer {
  margin-top: 24rpx;
  padding: 24rpx;
  text-align: center;
  background-color: #fff;
  border-radius: 32rpx;
  border: 2rpx solid rgba(99,102,241,0.12);
}

.recommend-footer-text {
  font-size: 26rpx;
  color: #6366F1;
  font-weight: 600;
}

.recommend-empty {
  padding: 48rpx;
  text-align: center;
  background-color: #fff;
  border-radius: 32rpx;
  border: 2rpx solid rgba(0,0,0,0.04);
}

.recommend-empty-text {
  font-size: 24rpx;
  color: rgba(0,0,0,0.3);
}

/* ============ Utility classes ============ */
.flex-row {
  display: flex;
  align-items: center;
}

.text-bold {
  font-weight: bold;
}

.text-small {
  font-size: 12px;
}

.text-xs {
  font-size: 10px;
}

.text-muted {
  color: rgba(0,0,0,0.4);
}

<!--pages/topics/topics.wxml - 100%复刻 kangaroo-math-brain TopicTraining -->
<view class="topics-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 学习复盘 -->
    <view class="insight-card">
      <view class="insight-decorator"></view>
      <view class="insight-content">
        <view class="insight-header flex-row">
          <view class="insight-icon-box">
            <text>📖</text>
          </view>
          <text class="insight-title text-small text-bold">学习复盘</text>
        </view>
        <block wx:if="{{isLoggedIn}}">
          <view class="insight-message">
            <text wx:if="{{insightData.analysis_base > 0}}" class="text-bold">你在 <text class="highlight">{{insightData.weakest_topic_title}}</text> 模块表现略显吃力，建议本周重点突破。</text>
            <text wx:else class="text-bold">继续练习更多题目，系统将为你分析薄弱环节。</text>
          </view>
          <view class="insight-footer flex-row">
            <view class="insight-badge" wx:if="{{insightData.analysis_base > 0}}">
              <text class="badge-icon">📈</text>
              <text class="badge-text text-small text-bold">进度提升 {{insightData.progress_gain}}%</text>
            </view>
            <text class="insight-sub text-small">基于最近 {{insightData.analysis_base > 0 ? insightData.analysis_base : '0'}} 道练习分析</text>
          </view>
        </block>
        <block wx:else>
          <view class="insight-message">
            <text class="text-bold">登录开启学习复盘，补齐知识漏洞</text>
          </view>
          <view class="insight-footer flex-row">
            <view class="login-insight-btn" bindtap="goToLogin">
              <text class="login-insight-btn-text text-bold">去登录</text>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- Topics Grid (4 columns) -->
    <view wx:if="{{isLoggedIn}}" class="topics-section">
      <view class="section-header flex-row">
        <text class="section-title text-bold">重点突破专题</text>
      </view>

      <view class="topics-grid">
        <block wx:for="{{filteredTopics}}" wx:key="id">
          <view class="topic-card {{item.cardBgClass}}" data-id="{{item.id}}" bindtap="selectTopic">
            <view class="topic-icon-box {{item.bgClass}}">
              <image wx:if="{{item.iconImage}}" src="{{item.iconImage}}" class="topic-icon-img" mode="aspectFill" />
              <text wx:else class="topic-icon">{{item.iconEmoji}}</text>
            </view>
            <view class="topic-info">
              <text class="topic-title text-small text-bold">{{item.title}}</text>
              <view class="topic-progress-bar" wx:if="{{item.progress > 0}}">
                <view class="topic-progress-fill {{item.progressClass}}" style="width: {{item.progress}}%;"></view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- 推荐题目列表（已登录） -->
    <view wx:if="{{isLoggedIn}}" class="recommend-section">
      <view class="section-header flex-row">
        <text class="section-title text-bold">推荐题目</text>
        <text class="recommend-topic-label" wx:if="{{recommendTopicTitle}}">基于「{{recommendTopicTitle}}」</text>
      </view>

      <view wx:if="{{recommendLoading}}" class="recommend-loading">
        <text>加载推荐中...</text>
      </view>

      <block wx:if="{{!recommendLoading && recommendQuestions.length > 0}}">
        <view class="recommend-card-grid">
          <view class="question-card" wx:for="{{recommendQuestions}}" wx:key="id" data-id="{{item.id}}" data-index="{{index}}" bindtap="goToRecommend">
            <view class="question-card-top">
              <view class="question-card-num">#{{index + 1}}</view>
              <text class="q-type-badge {{item.topicClass}} text-small text-bold">{{item.topicTitle || '专题'}}</text>
              <text class="q-diff-badge">Level {{item.difficulty_level}}</text>
            </view>
            <view class="question-card-body">
              <rich-text wx:if="{{item.content && item.content.text}}" nodes="{{item.content.text}}" class="question-card-rich"></rich-text>
              <text wx:else class="question-card-text">{{item.title}}</text>
            </view>
          </view>
        </view>
        <view class="recommend-footer" bindtap="goToRecommend">
          <text class="recommend-footer-text">开始练习全部推荐题目 ›</text>
        </view>
      </block>

      <view wx:if="{{!recommendLoading && recommendQuestions.length === 0}}" class="recommend-empty" bindtap="goToRecommend">
        <text class="recommend-empty-text">暂无推荐题目，点击刷新</text>
      </view>
    </view>

  </block>
</view>
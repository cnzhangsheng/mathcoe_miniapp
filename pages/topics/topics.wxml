<!--pages/topics/topics.wxml - 100%复刻 kangaroo-math-brain TopicTraining -->
<view class="topics-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- AI Mastery Insight -->
    <view class="insight-card" wx:if="{{insightData}}">
      <view class="insight-decorator"></view>
      <view class="insight-content">
        <view class="insight-header flex-row">
          <view class="insight-icon-box">
            <text>✨</text>
          </view>
          <text class="insight-title text-small text-bold">AI 学习洞察</text>
        </view>
        <view class="insight-message">
          <text class="text-bold">你在 <text class="highlight">{{insightData.weakest_topic_title}}</text> 模块表现略显吃力，建议本周重点突破。</text>
        </view>
        <view class="insight-footer flex-row">
          <view class="insight-badge">
            <text class="badge-icon">📈</text>
            <text class="badge-text text-small text-bold">进度提升 {{insightData.progress_gain}}%</text>
          </view>
          <text class="insight-sub text-small">基于最近 {{insightData.analysis_base}} 道练习分析</text>
        </view>
      </view>
    </view>

    <!-- Topics Grid (4 columns) -->
    <view class="topics-section">
      <view class="section-header flex-row">
        <text class="section-title text-bold">重点突破专题</text>
      </view>

      <view class="topics-grid">
        <block wx:for="{{filteredTopics}}" wx:key="id">
          <view class="topic-card {{item.cardBgClass}}" data-id="{{item.id}}" bindtap="selectTopic">
            <view class="topic-icon-box {{item.bgClass}}">
              <image wx:if="{{item.iconImage}}" src="{{item.iconImage}}" class="topic-icon-img" mode="aspectFill" />
              <text wx:else class="topic-icon">{{item.iconEmoji}}</text>
            </view>
            <view class="topic-info">
              <text class="topic-title text-small text-bold">{{item.title}}</text>
              <view class="topic-progress-bar" wx:if="{{item.progress > 0}}">
                <view class="topic-progress-fill {{item.progressClass}}" style="width: {{item.progress}}%;"></view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- Exam Papers Section -->
    <view class="exam-section">
      <!-- 袋鼠考卷 / 我的考卷 tabs -->
      <view class="paper-tab-bar">
        <view class="paper-tab-left">
          <view class="paper-tab {{paperTab === 'kangaroo' ? 'paper-tab-active' : ''}}" data-tab="kangaroo" bindtap="switchPaperTab">
            <text class="paper-tab-text">袋鼠考卷</text>
          </view>
          <view class="paper-tab {{paperTab === 'my' ? 'paper-tab-active' : ''}}" data-tab="my" bindtap="switchPaperTab">
            <text class="paper-tab-text">我的考卷</text>
          </view>
        </view>
        <view class="generate-topic-btn" bindtap="goToGeneratePaper">
          <text class="generate-topic-btn-icon">+</text>
          <text class="generate-topic-btn-text text-small text-bold">智能组卷</text>
        </view>
      </view>

      <!-- 考卷类型筛选（仅袋鼠考卷） -->
      <view class="paper-type-filter flex-row" wx:if="{{paperTab === 'kangaroo'}}">
        <block wx:for="{{paperTypeTabs}}" wx:key="value">
          <view class="type-tab {{selectedPaperType === item.value ? 'type-tab-active' : ''}}" data-type="{{item.value}}" bindtap="selectPaperType">
            <text class="type-tab-text">{{item.label}}</text>
          </view>
        </block>
      </view>

      <!-- 我的考卷列表 -->
      <view class="exam-list" wx:if="{{paperTab === 'my'}}">
        <block wx:for="{{myPapers}}" wx:key="id">
          <view class="exam-card" data-id="{{item.id}}" bindtap="selectExamPaper">
            <view class="exam-left">
              <view class="exam-icon-box exam-icon-box-green">
                <image class="exam-icon-img" src="{{imageBaseUrl + 'icons/icon-exam-custom.png'}}" mode="aspectFit"></image>
              </view>
              <text class="exam-left-label">{{item.typeLabel}}</text>
            </view>
            <view class="exam-middle">
              <view class="exam-top flex-row">
                <view class="level-badge level-badge-green">
                  <text class="level-text text-bold">Level {{item.difficulty_level}}</text>
                </view>
                <view class="new-badge" wx:if="{{item.is_new}}">
                  <text class="new-text text-bold">New</text>
                </view>
              </view>
              <text class="exam-title text-bold">{{item.title}}</text>
              <view class="exam-bottom flex-row">
                <view class="exam-meta flex-row">
                  <text class="meta-icon">⏱</text>
                  <text class="meta-text">{{item.duration || 75}} 分钟</text>
                </view>
                <text class="meta-text">{{item.total_questions}} 题</text>
                <text class="done-inline-text" wx:if="{{item.user_completed}}">· 正确率{{item.user_score}}%</text>
              </view>
            </view>
            <view class="exam-right exam-actions">
              <view class="action-btn" catchtap="downloadPdf" data-id="{{item.id}}">
                <image class="action-btn-icon-img" src="{{imageBaseUrl + 'icons/icon-pdf.png'}}" mode="aspectFit"></image>
              </view>
              <view class="action-btn action-btn-danger" catchtap="deletePaper" data-id="{{item.id}}">
                <image class="action-btn-icon-img" src="{{imageBaseUrl + 'icons/icon-delete.png'}}" mode="aspectFit"></image>
              </view>
            </view>
          </view>
        </block>
      </view>

      <!-- 系统考卷列表 -->
      <view class="exam-list" wx:else>
        <block wx:for="{{examPapers}}" wx:key="id">
          <view class="exam-card" data-id="{{item.id}}" bindtap="selectExamPaper">
            <view class="exam-left">
              <view class="exam-icon-box">
                <image class="exam-icon-img" src="{{item.typeIcon}}" mode="aspectFit"></image>
              </view>
              <text class="exam-left-label">{{item.typeLabel}}</text>
            </view>
            <view class="exam-middle">
              <view class="exam-top flex-row">
                <view class="level-badge">
                  <text class="level-text text-bold">Level {{item.difficulty_level}}</text>
                </view>
                <view class="new-badge" wx:if="{{item.is_new}}">
                  <text class="new-text text-bold">New</text>
                </view>
              </view>
              <text class="exam-title text-bold">{{item.title}}</text>
              <view class="exam-bottom flex-row">
                <view class="exam-meta flex-row">
                  <text class="meta-icon">⏱</text>
                  <text class="meta-text">{{item.duration || 75}} 分钟</text>
                </view>
                <text class="meta-text">{{item.total_questions}} 题</text>
                <text class="done-inline-text" wx:if="{{item.user_completed}}">· 正确率{{item.user_score}}%</text>
              </view>
            </view>
            <view class="exam-right">
              <view class="download-btn" wx:if="{{item.file_path}}" catchtap="downloadPdf" data-id="{{item.id}}">
                <image class="action-btn-icon-img" src="{{imageBaseUrl + 'icons/icon-pdf.png'}}" mode="aspectFit"></image>
              </view>
              <view class="download-placeholder" wx:else></view>
            </view>
          </view>
        </block>
      </view>

      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{paperTab === 'my' && myPapersHasMore || paperTab === 'kangaroo' && hasMore}}">
        <text class="load-more-text">加载更多...</text>
      </view>

      <!-- 无数据提示 -->
      <view class="no-data" wx:if="{{paperTab === 'my' && myPapers.length === 0 || paperTab === 'kangaroo' && examPapers.length === 0}}">
        <text class="no-data-text text-small">{{paperTab === 'my' ? '暂无我的考卷' : '暂无袋鼠考卷数据'}}</text>
      </view>
    </view>
  </block>

  <!-- PDF下载进度 -->
  <view wx:if="{{pdfProgress !== 0}}" class="pdf-progress-mask">
    <view class="pdf-progress-box">
      <text class="pdf-progress-title" wx:if="{{pdfProgress === -1}}">正在生成PDF...</text>
      <text class="pdf-progress-title" wx:else>正在下载PDF...</text>
      <view class="pdf-progress-track" wx:if="{{pdfProgress > 0}}">
        <view class="pdf-progress-bar" style="width: {{pdfProgress}}%"></view>
      </view>
      <text class="pdf-progress-text" wx:if="{{pdfProgress > 0}}">{{pdfProgress}}%</text>
      <text class="pdf-progress-text" wx:elif="{{pdfProgress === -1}}">即将开始下载</text>
    </view>
  </view>
</view>
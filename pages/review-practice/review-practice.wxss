/* pages/review-practice/review-practice.wxss */
@import "../../styles/practice-common.wxss";

page {
  height: 100%;
  overflow: hidden;
}

.review-practice-page {
  height: 100%;
  background-color: #F8F8F8;
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  box-sizing: border-box;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx;
  background-color: #fff;
  border-radius: 32rpx;
}

.loading-icon {
  font-size: 48rpx;
}

.loading-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.4);
}

/* Swiper */
.review-swiper {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.question-area {
  height: 100%;
  padding: 8rpx 4rpx 32rpx;
  box-sizing: border-box;
}

.question-card {
  padding: 32rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}

.question-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.question-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.question-title {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.85);
}

/* Topic type badge - matching discover page */
.q-type-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.q-type-badge.topic-yunsuan {
  background-color: #FFF0D6;
  color: #FF8A00;
}
.q-type-badge.topic-luoji {
  background-color: #DCFFE4;
  color: #10B981;
}
.q-type-badge.topic-tuxing {
  background-color: #FFE8EC;
  color: #FF6B8A;
}
.q-type-badge.topic-yingyong {
  background-color: #E0F7E9;
  color: #38D9A9;
}
.q-type-badge.topic-default {
  background-color: #FFF5F5;
  color: #FF8787;
}

/* Difficulty badge */
.q-diff-badge {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background-color: #FEF3C7;
  color: #D97706;
  flex-shrink: 0;
}

.question-count {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.5);
}

.question-type-text {
  color: rgba(0, 0, 0, 0.5);
}

.question-content {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.85);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* rich-text 内部样式 */
.question-content rich-text {
  width: 100%;
}

.question-content p {
  margin: 0;
  padding: 0;
}

.complete-scroll {
  width: 100%;
  height: 100%;
}

.complete-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  min-height: 80vh;
  padding: 48rpx 48rpx 64rpx;
  box-sizing: border-box;
}

/* Score Ring */
.score-ring-wrap {
  margin: 48rpx 0 32rpx;
}

.score-ring {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07C160, #10B981);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 16rpx 40rpx rgba(7, 193, 96, 0.25);
}

.score-ring-inner {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.score-ring-value {
  font-size: 56rpx;
  color: #07C160;
}

.score-ring-label {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.4);
}

/* Motto */
.complete-motto {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.7);
  margin-bottom: 40rpx;
}

/* Stats Card */
.complete-stats-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx 24rpx;
  width: 100%;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.complete-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.complete-stat-value {
  font-size: 36rpx;
  color: rgba(0, 0, 0, 0.85);
}

.complete-stat-label {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.4);
}

.complete-stat-divider {
  width: 2rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.06);
}

/* Progress Bar */
.complete-progress-wrap {
  width: 100%;
  margin-bottom: 48rpx;
}

.complete-progress-label {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.complete-progress-text {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
}

.complete-progress-bar {
  height: 16rpx;
  background-color: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.complete-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #07C160, #10B981);
  transition: width 0.5s;
}

/* Buttons */
.complete-buttons {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.complete-btn {
  flex: 1;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.complete-btn-primary {
  background: linear-gradient(135deg, #07C160, #10B981);
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
}

.complete-btn-secondary {
  background-color: rgba(0, 0, 0, 0.05);
}

.complete-btn-text {
  font-size: 28rpx;
  font-weight: bold;
}

.complete-btn-primary .complete-btn-text {
  color: #fff;
}

.complete-btn-secondary .complete-btn-text {
  color: rgba(0, 0, 0, 0.6);
}

.success-color {
  color: #10B981;
}

.danger-color {
  color: #F43F5E;
}

.primary-color {
  color: #07C160;
}

.card {
  background-color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.primary-bg {
  background-color: #07C160;
}


/* pages/review-practice/review-practice.wxss */

.review-practice-page {
  padding: 20rpx;
  padding-bottom: 100rpx;
  background-color: #F8F8F8;
  min-height: 100vh;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx;
  background-color: #fff;
  border-radius: 32rpx;
}

.loading-icon {
  font-size: 48rpx;
}

.loading-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.4);
}

.question-card {
  padding: 32rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}

.question-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.question-title {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.85);
}

.question-count {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.5);
}

.question-content {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.85);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* rich-text 内部样式 */
.question-content rich-text {
  width: 100%;
}

.question-content p {
  margin: 0;
  padding: 0;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 32rpx 48rpx;
  border-radius: 48rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.03);
  background-color: #fff;
  transition: all 0.2s;
}

.option-item.selected {
  background-color: rgba(99, 102, 241, 0.1);
  border-color: #6366F1;
  box-shadow: 0 8rpx 16rpx rgba(99, 102, 241, 0.1);
}

.option-item.correct {
  background-color: rgba(16, 185, 129, 0.1);
  border-color: #10B981;
  box-shadow: 0 8rpx 16rpx rgba(16, 185, 129, 0.1);
}

.option-item.wrong {
  background-color: rgba(244, 63, 94, 0.1);
  border-color: #F43F5E;
  box-shadow: 0 8rpx 16rpx rgba(244, 63, 94, 0.1);
}

.option-label-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.05);
}

.option-label-box.active {
  background-color: #6366F1;
}

.option-label-box.correct-label {
  background-color: #10B981;
}

.option-label-box.wrong-label {
  background-color: #F43F5E;
}

.option-label {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.85);
}

.option-label-box.active .option-label,
.option-label-box.correct-label .option-label,
.option-label-box.wrong-label .option-label {
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.85);
  line-height: 1.5;
}

.option-text p {
  margin: 0;
  line-height: 1.5;
}

.option-item.selected .option-text,
.option-item.correct .option-text,
.option-item.wrong .option-text {
  color: rgba(0, 0, 0, 0.8);
}

.option-status {
  margin-left: auto;
  font-size: 40rpx;
  color: #10B981;
}

.option-status.wrong-status {
  color: #F43F5E;
}

.result-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
}

.result-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.result-header.success {
  color: #10B981;
}

.result-header.error {
  color: #EF4444;
}

.result-icon {
  font-size: 32rpx;
}

.result-text {
  font-size: 28rpx;
  font-weight: bold;
}

.answer-info {
  padding: 16rpx;
  background-color: rgba(0, 0, 0, 0.02);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.answer-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.answer-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
}

.answer-value {
  font-size: 24rpx;
  font-weight: bold;
  margin-left: 8rpx;
}

.answer-value.correct {
  color: #10B981;
}

.answer-value.wrong {
  color: #EF4444;
}

.explanation-box {
  padding: 16rpx;
  background-color: #FEF3C7;
  border-radius: 16rpx;
}

.explanation-label {
  font-size: 24rpx;
  font-weight: bold;
  color: #92400E;
  margin-bottom: 8rpx;
}

.explanation-text {
  font-size: 24rpx;
  color: #78350F;
  line-height: 1.6;
}

.explanation-text p {
  margin: 0;
  padding: 0;
}

.action-buttons {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}

.submit-btn, .next-btn {
  padding: 24rpx 64rpx;
  border-radius: 32rpx;
}

.submit-text, .next-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

.complete-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 48rpx;
}

.complete-icon-box {
  width: 160rpx;
  height: 160rpx;
  background-color: #D1FAE5;
  border-radius: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.complete-icon {
  font-size: 64rpx;
}

.complete-title {
  font-size: 40rpx;
  font-weight: bold;
  color: rgba(0, 0, 0, 0.85);
  margin-bottom: 16rpx;
}

.complete-stats {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.5);
  margin-bottom: 48rpx;
}

.complete-buttons {
  display: flex;
  gap: 24rpx;
}

.home-btn, .review-btn {
  padding: 24rpx 48rpx;
  border-radius: 32rpx;
}

.home-btn {
  background-color: #07C160;
}

.home-text, .review-btn-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.review-btn {
  background-color: rgba(0, 0, 0, 0.1);
}

.review-btn-text {
  color: rgba(0, 0, 0, 0.7);
}

.card {
  background-color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.primary-bg {
  background-color: #07C160;
}
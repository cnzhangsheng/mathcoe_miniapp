<!--pages/index/index.wxml - 新首页设计 -->
<view class="home-page">

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-card">
      <view class="loading-icon-box">
        <text class="loading-icon">🔄</text>
      </view>
      <text class="loading-text text-small">正在加载...</text>
    </view>
  </view>

  <block wx:if="{{!loading && isLoggedIn}}">
    <!-- 用户区域 -->
    <view class="user-header">
      <view class="user-info">
        <view class="avatar-wrapper">
          <image class="avatar" src="{{imageBaseUrl + 'default-avatar.png'}}" mode="aspectFill"></image>
        </view>
        <view class="user-text">
          <text class="user-greeting text-bold">{{userInfo.nickname || '数学小达人'}}，{{greetingText}}</text>
          <text class="user-sub text-small">今日目标完成 {{todayDone}}/{{dailyGoal}} 题</text>
        </view>
      </view>
    </view>

    <!-- 今日目标进度 -->
    <view class="goal-section">
      <view class="goal-header flex-row">
        <view class="goal-icon-box">
          <text>🎯</text>
        </view>
        <text class="goal-title text-bold">今日目标</text>
        <text class="goal-count text-small">{{todayDone}}/{{dailyGoal}} 题</text>
      </view>
      <view class="goal-progress-bar">
        <view class="goal-progress-fill primary-bg" style="width: {{goalProgress}}%;"></view>
      </view>
      <view class="goal-hint" wx:if="{{goalProgress < 100}}">
        <text class="goal-hint-text text-small text-muted">还差 {{dailyGoal - todayDone}} 题，加油！</text>
      </view>
      <view class="goal-complete" wx:if="{{goalProgress >= 100}}">
        <text class="goal-complete-icon">✅</text>
        <text class="goal-complete-text text-small text-bold">今日目标已达成！</text>
      </view>
    </view>

    <!-- 本周/本月学习统计 -->
    <view class="stats-section">
      <view class="stats-header flex-between">
        <view class="stats-tabs flex-row">
          <view class="stats-tab {{statsTab === 'week' ? 'stats-tab-active' : ''}}" data-tab="week" bindtap="switchStatsTab">
            <text class="stats-tab-text text-bold">本周学习</text>
          </view>
          <view class="stats-tab {{statsTab === 'month' ? 'stats-tab-active' : ''}}" data-tab="month" bindtap="switchStatsTab">
            <text class="stats-tab-text text-bold">本月学习</text>
          </view>
        </view>
        <text class="stats-week text-small text-muted">{{statsTab === 'week' ? weekRange : monthRange}}</text>
      </view>

      <!-- 本周统计 -->
      <view class="stats-grid" wx:if="{{statsTab === 'week'}}">
        <view class="stat-item">
          <text class="stat-value text-bold">{{weekQuestions}}</text>
          <text class="stat-label text-small text-muted">答题数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value text-bold primary-color">{{weekCorrectRate}}%</text>
          <text class="stat-label text-small text-muted">正确率</text>
        </view>
        <view class="stat-item">
          <text class="stat-value text-bold rose-color">{{weekWrongCount}}</text>
          <text class="stat-label text-small text-muted">本周错题</text>
        </view>
        <view class="stat-item">
          <text class="stat-value text-bold amber-color">{{favoriteCount}}</text>
          <text class="stat-label text-small text-muted">收藏数</text>
        </view>
      </view>

      <!-- 本月统计 -->
      <view class="stats-grid" wx:if="{{statsTab === 'month'}}">
        <view class="stat-item">
          <text class="stat-value text-bold">{{monthQuestions}}</text>
          <text class="stat-label text-small text-muted">答题数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value text-bold primary-color">{{monthCorrectRate}}%</text>
          <text class="stat-label text-small text-muted">正确率</text>
        </view>
        <view class="stat-item">
          <text class="stat-value text-bold rose-color">{{monthWrongCount}}</text>
          <text class="stat-label text-small text-muted">本月错题</text>
        </view>
        <view class="stat-item">
          <text class="stat-value text-bold amber-color">{{favoriteCount}}</text>
          <text class="stat-label text-small text-muted">收藏数</text>
        </view>
      </view>
    </view>

    <!-- 快捷入口 (4个大按钮) -->
    <view class="quick-actions">
      <view class="action-item primary-action" bindtap="goToDiscover">
        <view class="action-icon-box primary-icon">
          <image class="action-icon-img" src="{{imageBaseUrl + 'icons/icon_explore.png'}}" mode="aspectFit"></image>
        </view>
        <text class="action-title text-bold">探索</text>
        <text class="action-sub text-small">随机刷题</text>
      </view>

      <view class="action-item purple-action" bindtap="goToTopics">
        <view class="action-icon-box purple-icon">
          <image class="action-icon-img" src="{{imageBaseUrl + 'icons/icon_topic.png'}}" mode="aspectFit"></image>
        </view>
        <text class="action-title text-bold">专题</text>
        <text class="action-sub text-small">专项训练</text>
      </view>

      <view class="action-item amber-action" bindtap="goToExamPaper">
        <view class="action-icon-box amber-icon">
          <image class="action-icon-img" src="{{imageBaseUrl + 'icons/icon_exam.png'}}" mode="aspectFit"></image>
        </view>
        <text class="action-title text-bold">模考</text>
        <text class="action-sub text-small">真题演练</text>
      </view>

      <view class="action-item rose-action" bindtap="goToReview">
        <view class="action-icon-box rose-icon">
          <image class="action-icon-img" src="{{imageBaseUrl + 'icons/icon_error.png'}}" mode="aspectFit"></image>
        </view>
        <text class="action-title text-bold">错题</text>
        <text class="action-sub text-small">{{wrongCount}}题待练</text>
      </view>
    </view>

    <!-- 动态 Banner -->
    <view wx:if="{{banners.length > 0}}" class="banner-section">
      <swiper
        class="banner-swiper"
        indicator-dots="{{banners.length > 1}}"
        indicator-color="rgba(255,255,255,0.4)"
        indicator-active-color="#fff"
        autoplay="{{banners.length > 1}}"
        interval="4000"
        circular="{{banners.length > 1}}"
        current="{{bannerCurrent}}"
        bindchange="onBannerChange"
      >
        <block wx:for="{{banners}}" wx:key="index">
          <swiper-item class="banner-swiper-item">
            <view class="banner-card" data-index="{{index}}" bindtap="onBannerTap">
              <image class="banner-image" src="{{item.image_url}}" mode="aspectFill"></image>
            </view>
          </swiper-item>
        </block>
      </swiper>
    </view>

    <!-- 能力雷达（多边形） -->
    <view class="radar-card">
      <view class="radar-header">
        <view class="radar-title-row flex-row">
          <view class="radar-icon-box">
            <text>📊</text>
          </view>
          <text class="radar-title text-bold">能力雷达</text>
        </view>
      </view>

      <!-- 多边形雷达图（带标签） -->
      <view class="radar-chart-container">
        <canvas type="2d" id="radarCanvas" class="radar-canvas" canvas-id="radarCanvas"></canvas>
      </view>
    </view>

    <!-- 智能组卷 -->
    <view class="recommend-section">
      <view class="section-header flex-row">
        <text class="section-title text-bold">智能组卷</text>
      </view>
      <view class="generate-entry-card" bindtap="goToGeneratePaper">
        <view class="generate-entry-left">
          <view class="generate-entry-icon-box">
            <text class="generate-entry-icon">🤖</text>
          </view>
        </view>
        <view class="generate-entry-middle">
          <text class="generate-entry-title text-bold">AI 智能组卷</text>
          <text class="generate-entry-sub text-small">选择专题和难度，生成专属考卷</text>
        </view>
        <view class="generate-entry-right">
          <text class="generate-entry-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 我的考卷 -->
    <view class="recommend-section">
      <view class="section-header flex-row">
        <text class="section-title text-bold">我的考卷</text>
      </view>

      <view class="exam-list">
        <block wx:for="{{myPapers}}" wx:key="id">
          <view class="exam-card" data-id="{{item.id}}" bindtap="selectExamPaper">
            <view class="exam-left">
              <view class="exam-icon-box exam-icon-box-green">
                <image class="exam-icon-img" src="{{imageBaseUrl + 'icons/icon-exam-custom.png'}}" mode="aspectFit"></image>
              </view>
            </view>
            <view class="exam-middle">
              <view class="exam-top flex-row">
                <view class="level-badge level-badge-green">
                  <text class="level-text text-bold">Level {{item.difficulty_level}}</text>
                </view>
                <view class="new-badge" wx:if="{{item.is_new}}">
                  <text class="new-text text-bold">New</text>
                </view>
              </view>
              <text class="exam-title text-bold">{{item.title}}</text>
              <view class="exam-bottom flex-row">
                <view class="exam-meta flex-row">
                  <text class="meta-icon">⏱</text>
                  <text class="meta-text">{{item.duration || 75}} 分钟</text>
                </view>
                <text class="meta-text">{{item.total_questions}} 题</text>
              </view>
              <view class="done-badge" wx:if="{{item.user_completed}}">
                <text class="done-text text-bold">已作答，正确率：{{item.user_score}}%</text>
              </view>
            </view>
            <view class="exam-right exam-actions">
              <view class="action-btn" catchtap="downloadPdf" data-id="{{item.id}}">
                <image class="action-btn-icon-img" src="{{imageBaseUrl + 'icons/icon-pdf.png'}}" mode="aspectFit"></image>
              </view>
              <view class="action-btn action-btn-danger" catchtap="deletePaper" data-id="{{item.id}}">
                <image class="action-btn-icon-img" src="{{imageBaseUrl + 'icons/icon-delete.png'}}" mode="aspectFit"></image>
              </view>
            </view>
          </view>
        </block>
      </view>

      <!-- 无数据提示 -->
      <view class="no-data" wx:if="{{myPapers.length === 0}}">
        <text class="no-data-text text-small">暂无我的考卷</text>
      </view>
    </view>

    <!-- 今日建议 -->
    <view class="suggestion-card" wx:if="{{weakTopic}}">
      <view class="suggestion-header flex-row">
        <view class="suggestion-icon-box">
          <text>💡</text>
        </view>
        <text class="suggestion-title text-bold">今日建议</text>
      </view>
      <view class="suggestion-content">
        <text class="suggestion-text">你在「<text class="suggestion-highlight text-bold">{{weakTopic.title}}</text>」模块较弱，建议今天重点练习。</text>
      </view>
      <view class="suggestion-btn" data-id="{{weakTopic.id}}" bindtap="goToTopicDetail">
        <text class="suggestion-btn-text text-bold">去练习 ›</text>
      </view>
    </view>
  </block>

  <!-- 未登录状态 -->
  <view wx:if="{{!loading && !isLoggedIn}}" class="login-prompt">
    <view class="prompt-card">
      <view class="prompt-icon-box">
        <text class="prompt-icon">🧮</text>
      </view>
      <text class="prompt-title text-bold">袋鼠数学助理</text>
      <text class="prompt-sub text-small text-muted">每天10分钟，数学思维突飞猛进</text>
      <view class="prompt-btn" bindtap="goToLogin">
        <text class="prompt-btn-text text-bold">开始学习</text>
      </view>
    </view>
  </view>

</view>
/* pages/index/index.wxss - 新首页样式 */

.home-page {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 32rpx;
  padding-bottom: 120rpx;
}

/* Loading State */
.loading-state {
  min-height: calc(100vh - 64rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-card {
  background-color: #fff;
  border-radius: 64rpx;
  padding: 80rpx 64rpx;
  text-align: center;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.loading-icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: rgba(99, 102, 241, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 48rpx;
}

.loading-icon {
  font-size: 80rpx;
}

.loading-text {
  color: rgba(0, 0, 0, 0.5);
}

/* User Header */
.user-header {
  padding: 24rpx 32rpx 28rpx;
  background-color: #fff;
  border-radius: 48rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrapper {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background-color: rgba(99, 102, 241, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar {
  width: 100%;
  height: 100%;
}

.user-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.user-greeting {
  font-size: 34rpx;
  color: rgba(0, 0, 0, 0.9);
}

/* Goal progress inside user header */
.goal-progress-section {
  margin-top: 10rpx;
}

.goal-header-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.goal-header-row .goal-count-text {
  margin-left: auto;
}

.goal-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
}

.goal-count-text {
  font-size: 24rpx;
  color: #07C160;
  font-weight: 600;
}

/* Goal Section */
.goal-section {
  background-color: #fff;
  border-radius: 48rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.goal-header {
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.goal-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background-color: rgba(7, 193, 96, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.goal-icon-box text {
  font-size: 32rpx;
}

.goal-title {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.9);
}

.goal-count {
  color: rgba(0, 0, 0, 0.5);
  margin-left: auto;
}

.goal-progress-bar {
  height: 16rpx;
  background-color: rgba(0, 0, 0, 0.05);
  border-radius: 8rpx;
  overflow: hidden;
}

.goal-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.goal-hint {
  margin-top: 16rpx;
  text-align: center;
}

.goal-complete {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.goal-complete-icon {
  font-size: 28rpx;
}

.goal-complete-text {
  color: #07C160;
}

/* Quick Actions */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.action-item {
  background-color: #fff;
  border-radius: 40rpx;
  padding: 32rpx 12rpx;
  text-align: center;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-icon {
  background-color: rgba(7, 193, 96, 0.12);
}

.purple-icon {
  background-color: rgba(99, 102, 241, 0.12);
}

.amber-icon {
  background-color: rgba(251, 191, 36, 0.12);
}

.rose-icon {
  background-color: rgba(244, 63, 94, 0.12);
}

.action-icon-img {
  width: 60rpx;
  height: 60rpx;
}

.action-title {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.85);
}

.action-sub {
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.4);
}

/* Banner Section */
.banner-section {
  margin-bottom: 24rpx;
  border-radius: 48rpx;
  overflow: hidden;
}

.banner-swiper {
  width: 100%;
  height: 250rpx;
  border-radius: 48rpx;
}

.banner-swiper-item {
  border-radius: 48rpx;
  overflow: hidden;
}

.banner-card {
  width: 100%;
  height: 100%;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.4));
}

.banner-overlay-text {
  font-size: 26rpx;
  color: #fff;
}

/* Countdown Card */
.countdown-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: rgba(99, 102, 241, 0.05);
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(99, 102, 241, 0.1);
}

.countdown-left {
  gap: 24rpx;
}

.timer-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.timer-icon-box text {
  font-size: 32rpx;
}

.countdown-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.countdown-label {
  color: rgba(0, 0, 0, 0.5);
}

.countdown-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.8);
}

.countdown-num {
  font-size: 32rpx;
}

.countdown-btn {
  padding: 16rpx 32rpx;
  background-color: #6366F1;
  border-radius: 24rpx;
}

.countdown-btn-text {
  color: #fff;
}

/* Radar Card */
.radar-card {
  background-color: #fff;
  border-radius: 48rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.radar-header {
  margin-bottom: 24rpx;
}

.radar-title-row {
  gap: 16rpx;
}

.radar-icon-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: rgba(99, 102, 241, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.radar-icon-box text {
  font-size: 24rpx;
}

.radar-title {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.9);
}

/* Radar Chart Container */
.radar-chart-container {
  width: 100%;
  height: 480rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radar-canvas {
  width: 480rpx;
  height: 480rpx;
}

.abilities-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ability-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ability-header {
  margin-bottom: 4rpx;
}

.ability-label {
  color: rgba(0, 0, 0, 0.7);
}

.ability-value {
  color: rgba(0, 0, 0, 0.4);
}

.ability-bar {
  height: 12rpx;
  background-color: rgba(0, 0, 0, 0.05);
  border-radius: 6rpx;
  overflow: hidden;
}

.ability-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.bar-orange {
  background-color: #FF8A00;
}

.bar-purple {
  background-color: #8B6CF6;
}

.bar-blue {
  background-color: #FF6B8A;
}

.bar-green {
  background-color: #38D9A9;
}

/* Section Header */
.section-header {
  margin-bottom: 24rpx;
}

.section-title-row {
  gap: 16rpx;
}

.section-icon-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: rgba(99, 102, 241, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-icon-box text {
  font-size: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.9);
}

.section-more {
  color: rgba(0, 0, 0, 0.4);
}

/* Recommend Section */
.recommend-section {
  margin-bottom: 24rpx;
}

.exam-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* End Tip */
.no-data {
  padding: 48rpx;
  text-align: center;
}

.no-data-text {
  color: rgba(0, 0, 0, 0.4);
  font-size: 26rpx;
}

.generate-entry-card {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  background: linear-gradient(135deg, rgba(99,102,241,0.08), rgba(99,102,241,0.03));
  border-radius: 56rpx;
  gap: 24rpx;
  border: 2rpx solid rgba(99,102,241,0.15);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.generate-entry-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background-color: rgba(99,102,241,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.generate-entry-icon {
  font-size: 44rpx;
}

.generate-entry-middle {
  flex: 1;
}

.generate-entry-title {
  font-size: 28rpx;
  color: #6366F1;
  margin-bottom: 4rpx;
}

.generate-entry-sub {
  color: rgba(99,102,241,0.5);
}

.generate-entry-arrow {
  font-size: 36rpx;
  color: rgba(99,102,241,0.3);
}

.exam-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background-color: #fff;
  border-radius: 48rpx;
  gap: 16rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.exam-left {
  flex-shrink: 0;
  margin-right: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.exam-left-label {
  font-size: 22rpx;
  color: rgba(0,0,0,0.5);
  font-weight: 600;
  white-space: nowrap;
}

.exam-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(99, 102, 241, 0.1);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.exam-icon-box-green {
  background-color: rgba(7, 193, 96, 0.1);
}

.exam-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.exam-middle {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.exam-top {
  gap: 16rpx;
  align-items: center;
  margin-bottom: 8rpx;
}

.level-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background-color: #FEF3C7;
  flex-shrink: 0;
  white-space: nowrap;
}

.level-badge-green {
  background-color: #FEF3C7;
}

.level-text {
  font-size: 24rpx;
  color: #D97706;
}

.new-badge {
  padding: 8rpx 12rpx;
  background-color: #F43F5E;
  border-radius: 8rpx;
}

.new-text {
  color: #fff;
  font-size: 18rpx;
}

.exam-done-badge {
  padding: 8rpx 12rpx;
  background-color: #10B981;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.exam-done-text {
  color: #fff;
  font-size: 22rpx;
}

.exam-title {
  display: block;
  color: rgba(0, 0, 0, 0.8);
  font-size: 14px;
  margin-bottom: 16rpx;
}

.exam-bottom {
  gap: 32rpx;
  color: rgba(0, 0, 0, 0.3);
  align-items: center;
}

.exam-meta {
  gap: 8rpx;
  align-items: center;
}

.meta-icon {
  font-size: 12px;
}

.meta-text {
  font-size: 10px;
}

.exam-right {
  margin-left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

/* 考卷模块 Tab 栏 */
.paper-tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.paper-tab-left {
  display: flex;
  gap: 12rpx;
}

.paper-tab {
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  background-color: rgba(0,0,0,0.04);
}

.paper-tab-active {
  background-color: #059669;
}

.paper-tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(0,0,0,0.5);
}

.paper-tab-active .paper-tab-text {
  color: #fff;
}

/* 考卷类型筛选 */
.paper-type-filter {
  gap: 12rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.type-tab {
  padding: 10rpx 24rpx;
  background-color: rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
}

.type-tab-active {
  background-color: #059669;
}

.type-tab-text {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
}

.type-tab-active .type-tab-text {
  color: #fff;
}

.download-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: rgba(7, 193, 96, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.download-placeholder {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.exam-actions {
  flex-direction: row;
  gap: 8rpx;
  align-items: center;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: rgba(7, 193, 96, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.action-btn-danger {
  background-color: rgba(244, 63, 94, 0.1);
}

/* Stats Section */
.stats-section {
  margin-bottom: 24rpx;
}

.stats-header {
  padding: 16rpx 0;
}

.stats-tabs {
  gap: 0;
  background-color: rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  padding: 4rpx;
}

.stats-tab {
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  transition: all 0.2s;
}

.stats-tab-active {
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.stats-tab-text {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.5);
}

.stats-tab-active .stats-tab-text {
  color: #07C160;
}

.stats-title-row {
  gap: 8rpx;
}

.stats-icon-box {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats-title {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.9);
}

.stats-week {
  color: rgba(0, 0, 0, 0.4);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background-color: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.stat-item {
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.9);
}

.stat-label {
  color: rgba(0, 0, 0, 0.4);
}

.primary-color {
  color: #07C160;
}

.rose-color {
  color: #F43F5E;
}

.amber-color {
  color: #F59E0B;
}

/* Suggestion Card */
.suggestion-card {
  background-color: rgba(251, 191, 36, 0.05);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(251, 191, 36, 0.1);
}

.suggestion-header {
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.suggestion-icon-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.suggestion-icon-box text {
  font-size: 24rpx;
}

.suggestion-title {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.9);
}

.suggestion-content {
  margin-bottom: 24rpx;
}

.suggestion-text {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.7);
  line-height: 1.5;
}

.suggestion-highlight {
  color: #F59E0B;
}

.suggestion-btn {
  display: inline-flex;
  padding: 16rpx 32rpx;
  background-color: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.suggestion-btn-text {
  font-size: 26rpx;
  color: #F59E0B;
}

/* Login Prompt */
.login-prompt {
  min-height: calc(100vh - 64rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.prompt-card {
  background-color: #fff;
  border-radius: 64rpx;
  padding: 80rpx 64rpx;
  text-align: center;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
  max-width: 600rpx;
}

.prompt-icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: rgba(7, 193, 96, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 48rpx;
}

.prompt-icon {
  font-size: 80rpx;
}

.prompt-title {
  font-size: 40rpx;
  color: rgba(0, 0, 0, 0.9);
  margin-bottom: 16rpx;
}

.prompt-sub {
  color: rgba(0, 0, 0, 0.5);
  margin-bottom: 48rpx;
}

.prompt-btn {
  padding: 32rpx 64rpx;
  background-color: #07C160;
  border-radius: 48rpx;
  display: inline-block;
  box-shadow: 0 16rpx 32rpx rgba(7, 193, 96, 0.2);
}

.prompt-btn-text {
  font-size: 32rpx;
  color: #fff;
}

/* Utility Classes */
.flex-row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-bold {
  font-weight: 700;
}

.text-small {
  font-size: 24rpx;
}

.text-muted {
  color: rgba(0, 0, 0, 0.5);
}

.end-tip {
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.end-tip-text {
  color: rgba(0, 0, 0, 0.3);
}

.primary-bg {
  background-color: #07C160;
}

.primary-color {
  color: #07C160;
}
/* PDF 下载进度 */
.pdf-progress-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pdf-progress-box {
  background: #fff;
  border-radius: 32rpx;
  padding: 64rpx;
  width: 500rpx;
  text-align: center;
}

.pdf-progress-title {
  font-size: 32rpx;
  color: rgba(0,0,0,0.85);
  margin-bottom: 32rpx;
  display: block;
}

.pdf-progress-track {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.pdf-progress-bar {
  height: 100%;
  background: #07C160;
  border-radius: 8rpx;
  transition: width 0.2s;
}

.pdf-progress-text {
  font-size: 28rpx;
  color: rgba(0,0,0,0.5);
  display: block;
}

/* 未登录头部引导条 */
.login-header-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 8rpx 0;
}

.login-header-icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: rgba(7, 193, 96, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.login-header-icon {
  font-size: 48rpx;
}

.login-header-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.login-header-title {
  font-size: 34rpx;
  color: rgba(0, 0, 0, 0.9);
}

.login-header-sub {
  color: rgba(0, 0, 0, 0.5);
}

.login-header-btn {
  padding: 16rpx 32rpx;
  background-color: #07C160;
  border-radius: 32rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

.login-header-btn-text {
  font-size: 26rpx;
  color: #fff;
}

/* 未登录空状态提示 */
.login-hint {
  background-color: #fff;
  border-radius: 48rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

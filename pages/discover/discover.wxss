/* pages/discover/discover.wxss - Swiper 滑动浏览 */
page {
  height: 100%;
  overflow: hidden;
}

.discover-page {
  height: 100%;
  background-color: #f8f8f8;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* Loading State */
.loading-state {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-card {
  background-color: #fff;
  border-radius: 64rpx;
  padding: 80rpx 64rpx;
  text-align: center;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.loading-icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: rgba(99, 102, 241, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 48rpx;
}

.loading-icon {
  font-size: 80rpx;
}

.loading-text {
  color: rgba(0, 0, 0, 0.5);
}

/* Empty State */
.empty-state {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-card {
  background-color: #fff;
  border-radius: 64rpx;
  padding: 80rpx 64rpx;
  text-align: center;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
  max-width: 600rpx;
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: rgba(99, 102, 241, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 48rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  font-size: 36rpx;
  color: rgba(0, 0, 0, 0.9);
  margin-bottom: 16rpx;
}

.empty-sub {
  color: rgba(0, 0, 0, 0.5);
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 32rpx 64rpx;
  background-color: #07C160;
  color: #fff;
  border-radius: 48rpx;
  display: inline-block;
  box-shadow: 0 16rpx 32rpx rgba(7, 193, 96, 0.2);
}

.empty-btn-text {
  font-size: 28rpx;
}

/* Swiper Wrapper */
.swiper-wrapper {
  height: 100%;
}

/* Swiper fills remaining height via flex */
.discover-swiper {
  height: 100%;
  width: 100%;
}

/* Question Area - 每个 swiper 项 */
.question-area {
  height: 100%;
  padding: 24rpx 4rpx 32rpx;
  box-sizing: border-box;
}

/* Swiper Loading placeholder */
.swiper-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.swiper-loading-text {
  color: rgba(0, 0, 0, 0.3);
}

/* Question Info Row */
.question-info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.topic-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.topic-badge.topic-yunsuan {
  background-color: #FFF0D6;
  color: #FF8A00;
}

.topic-badge.topic-luoji {
  background-color: #DCFFE4;
  color: #10B981;
}

.topic-badge.topic-tuxing {
  background-color: #FFE8EC;
  color: #FF6B8A;
}

.topic-badge.topic-yingyong {
  background-color: #E0F7E9;
  color: #38D9A9;
}

.topic-badge.topic-default {
  background-color: #FFF5F5;
  color: #FF8787;
}

.difficulty-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background-color: #FEF3C7;
  color: #D97706;
}

.question-type-badge {
  color: rgba(0, 0, 0, 0.5);
}

/* Question Card */
.question-card {
  background-color: #fff;
  border-radius: 64rpx;
  padding: 48rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.question-content-box {
  margin-bottom: 32rpx;
}

.question-content {
  font-size: 36rpx;
  color: rgba(0, 0, 0, 0.9);
  line-height: 1.6;
}

.question-content p {
  margin: 0;
  line-height: 1.6;
}

/* Options */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-item {
  position: relative;
  padding: 32rpx 48rpx;
  border-radius: 48rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.03);
  background-color: #fff;
  display: flex;
  align-items: center;
  gap: 32rpx;
  transition: all 0.2s;
}

.option-item.selected {
  background-color: rgba(99, 102, 241, 0.1);
  border-color: #6366F1;
  box-shadow: 0 8rpx 16rpx rgba(99, 102, 241, 0.1);
}

.option-item.correct {
  background-color: rgba(16, 185, 129, 0.1);
  border-color: #10B981;
  box-shadow: 0 8rpx 16rpx rgba(16, 185, 129, 0.1);
}

.option-item.wrong {
  background-color: rgba(244, 63, 94, 0.1);
  border-color: #F43F5E;
  box-shadow: 0 8rpx 16rpx rgba(244, 63, 94, 0.1);
}

.option-label-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.05);
}

.option-label-box.active {
  background-color: #6366F1;
}

.option-label-box.correct-label {
  background-color: #10B981;
}

.option-label-box.wrong-label {
  background-color: #F43F5E;
}

.option-label {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.85);
}

.option-label-box.active .option-label,
.option-label-box.correct-label .option-label,
.option-label-box.wrong-label .option-label {
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.85);
  line-height: 1.5;
}

.option-text p {
  margin: 0;
  line-height: 1.5;
}

.option-status {
  margin-left: auto;
  font-size: 40rpx;
  color: #10B981;
}

.option-status.wrong-status {
  color: #F43F5E;
}

/* Action Icons */
.action-icons-right {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
  padding-right: 32rpx;
}

.action-icon-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  background-color: rgba(0, 0, 0, 0.03);
}

.action-icon-btn.liked {
  background-color: rgba(99, 102, 241, 0.1);
}

.action-icon-btn.bookmarked {
  background-color: rgba(251, 191, 36, 0.1);
}

.action-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.action-count {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
}

.action-text {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
}

.action-icon-btn.bookmarked .action-text {
  color: #F59E0B;
}

/* Submit Answer */
.submit-row {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
}

.submit-answer-btn {
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(7, 193, 96, 0.2);
}

.submit-answer-btn.active {
  background-color: #07C160;
  color: #fff;
}

.submit-answer-text {
  font-size: 28rpx;
}

/* Analysis Section */
.analysis-section {
  margin-top: 48rpx;
}

.analysis-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.analysis-icon {
  font-size: 32rpx;
  color: #F59E0B;
}

.analysis-title {
  color: rgba(0, 0, 0, 0.6);
  letter-spacing: 4rpx;
}

.analysis-card {
  background-color: #fff;
  border-radius: 64rpx;
  padding: 64rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
  position: relative;
  overflow: hidden;
}

.analysis-card::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 128rpx;
  height: 128rpx;
  background-color: rgba(16, 185, 129, 0.05);
  border-radius: 50%;
  transform: translate(64rpx, -64rpx);
}

.answer-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

.answer-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 40rpx;
  background-color: #10B981;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(16, 185, 129, 0.2);
}

.answer-letter {
  font-size: 40rpx;
  color: #fff;
}

.answer-title {
  font-size: 36rpx;
  color: rgba(0, 0, 0, 0.9);
}

.logic-box {
  background-color: rgba(0, 0, 0, 0.02);
  border-radius: 48rpx;
  padding: 48rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  margin-bottom: 40rpx;
}

.logic-label {
  color: rgba(0, 0, 0, 0.3);
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
  display: block;
}

.logic-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.7);
  line-height: 1.6;
}

.logic-text p {
  margin: 0;
  line-height: 1.6;
}

/* Next Question Button */
.next-row {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
}

.next-btn {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 72rpx;
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  border-radius: 48rpx;
  box-shadow: 0 16rpx 32rpx rgba(99, 102, 241, 0.25);
}

.next-btn-text {
  font-size: 30rpx;
  color: #fff;
}

.next-btn-arrow {
  font-size: 32rpx;
  color: #fff;
}

/* Swipe Hint Overlay */
.swipe-hint {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background-color: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.swipe-hint-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.swipe-hint-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.hint-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.9);
  animation: hintPulse 2s ease-in-out infinite;
}

.hint-arrow.right {
  animation-delay: 0.3s;
}

.hint-arrow.flip {
  transform: scaleX(-1);
}

.hint-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.hint-sub {
  font-size: 26rpx;
  opacity: 0.7;
  font-weight: normal;
}

.hint-tap {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

@keyframes hintPulse {
  0%, 100% { opacity: 0.4; transform: translateX(0); }
  50% { opacity: 1; transform: translateX(12rpx); }
}

.hint-arrow.left {
  animation-name: hintPulseLeft;
}

@keyframes hintPulseLeft {
  0%, 100% { opacity: 0.4; transform: translateX(0); }
  50% { opacity: 1; transform: translateX(-12rpx); }
}

/* Utility */
.flex-row {
  display: flex;
  align-items: center;
}

.text-bold {
  font-weight: 900;
}

.text-small {
  font-size: 24rpx;
}

.text-xs {
  font-size: 20rpx;
}

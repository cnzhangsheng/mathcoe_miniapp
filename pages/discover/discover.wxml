<!-- pages/discover/discover.wxml - Swiper 滑动浏览 -->
<view class="discover-page">

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading && !swiperList.length}}">
    <view class="loading-card">
      <view class="loading-icon-box">
        <text class="loading-icon">🔄</text>
      </view>
      <text class="loading-text text-small">正在加载题目...</text>
    </view>
  </view>

  <!-- 无题目状态 -->
  <view class="empty-state" wx:if="{{!loading && !swiperList.length}}">
    <view class="empty-card">
      <view class="empty-icon-box">
        <text class="empty-icon">📚</text>
      </view>
      <text class="empty-title text-bold">暂无题目</text>
      <text class="empty-sub text-small">请稍后再试或刷新页面</text>
      <view class="empty-btn" bindtap="loadRandomQuestion">
        <text class="empty-btn-text text-bold">重新加载</text>
      </view>
    </view>
  </view>

  <!-- Swiper 滑动浏览 -->
  <block wx:if="{{swiperList.length > 0}}">
    <swiper current="{{swiperCurrent}}" duration="300" bindchange="onSwiperChange" class="discover-swiper">
      <swiper-item wx:for="{{swiperList}}" wx:for-item="card" wx:for-index="idx" wx:key="id">
        <scroll-view class="question-area" scroll-y>

          <block wx:if="{{card.question}}">
            <!-- 题目信息 -->
            <view class="question-info-row">
              <text class="topic-badge {{card.topicClass}} text-small text-bold">{{card.topicTitle}}</text>
              <text class="difficulty-badge text-small text-bold" wx:if="{{card.questionLevel}}">{{card.questionLevel}}</text>
              <text class="question-type-badge text-small text-muted">（{{card.questionType}}）</text>
            </view>

            <!-- Question Card -->
            <view class="question-card">
              <view class="question-content-box">
                <rich-text class="question-content" nodes="{{card.question.content || '题目内容'}}"></rich-text>
              </view>

              <view class="options-list">
                <block wx:for="{{card.question.options}}" wx:key="label">
                  <view class="option-item {{card.selectedOption === item.label ? 'selected' : ''}} {{card.showAnswer && card.question.answer === item.label ? 'correct' : ''}} {{card.showAnswer && card.selectedOption === item.label && card.question.answer !== item.label ? 'wrong' : ''}}"
                    data-option="{{item.label}}" data-index="{{idx}}" bindtap="selectOption">
                    <view class="option-label-box {{card.selectedOption === item.label ? 'active' : ''}} {{card.showAnswer && card.question.answer === item.label ? 'correct-label' : ''}} {{card.showAnswer && card.selectedOption === item.label && card.question.answer !== item.label ? 'wrong-label' : ''}}">
                      <text class="option-label text-bold">{{item.label}}</text>
                    </view>
                    <rich-text class="option-text {{card.selectedOption === item.label ? 'active-text' : ''}}" nodes="{{item.text || ''}}"></rich-text>
                    <text class="option-status" wx:if="{{card.showAnswer && card.question.answer === item.label}}">✓</text>
                    <text class="option-status wrong-status" wx:if="{{card.showAnswer && card.selectedOption === item.label && card.question.answer !== item.label}}">✗</text>
                  </view>
                </block>
              </view>
            </view>

            <!-- Like + Bookmark -->
            <view class="action-icons-right">
              <view class="action-icon-btn {{card.isFavorited ? 'bookmarked' : ''}}" bindtap="toggleFavorite" data-index="{{idx}}">
                <image class="action-icon-img" src="{{card.isFavorited ? (imageBaseUrl + 'icons/icon_bookmark_fill.png') : (imageBaseUrl + 'icons/icon_bookmark.png')}}" mode="aspectFit"></image>
                <text class="action-text">{{card.isFavorited ? '已收藏' : '收藏'}}</text>
              </view>
              <button class="action-icon-btn share-btn" open-type="share" data-index="{{idx}}">
                <image class="action-icon-img" src="{{imageBaseUrl + 'icons/icon_share.png'}}" mode="aspectFit"></image>
                <text class="action-text">分享</text>
              </button>
            </view>

            <!-- Submit Answer Button -->
            <view class="submit-row" wx:if="{{!card.showAnswer && card.selectedOption}}">
              <view class="submit-answer-btn active" bindtap="toggleAnswer" data-index="{{idx}}">
                <text class="submit-answer-text text-bold">提交答案</text>
              </view>
            </view>

            <!-- Analysis Section -->
            <view class="analysis-section" wx:if="{{card.showAnswer}}">
              <view class="analysis-header flex-row">
                <text class="analysis-icon">💡</text>
                <text class="analysis-title text-small text-bold">答案解析</text>
              </view>
              <view class="analysis-card">
                <view class="answer-row flex-row">
                  <view class="answer-box">
                    <text class="answer-letter text-bold">{{card.question.answer}}</text>
                  </view>
                  <view class="answer-info">
                    <text class="answer-title text-bold">正确答案：选项 {{card.question.answer}}</text>
                  </view>
                </view>
                <view class="logic-box">
                  <text class="logic-label text-xs text-bold">题目解析</text>
                  <rich-text class="logic-text" nodes="{{card.question.explanation || '暂无解析'}}"></rich-text>
                </view>
              </view>
              <!-- 下一题按钮 -->
              <view class="next-row">
                <view class="next-btn" bindtap="goNextQuestion" data-index="{{idx}}">
                  <text class="next-btn-text text-bold">下一题</text>
                  <text class="next-btn-arrow">→</text>
                </view>
              </view>
            </view>
          </block>

          <!-- 加载占位 -->
          <view class="swiper-loading" wx:if="{{!card.question}}">
            <text class="swiper-loading-text">加载中...</text>
          </view>
        </scroll-view>
      </swiper-item>
    </swiper>
  </block>

  <!-- 首次滑动引导 -->
  <view class="swipe-hint" wx:if="{{showSwipeHint}}" bindtap="dismissSwipeHint">
    <view class="swipe-hint-content">
      <view class="swipe-hint-row">
        <text class="hint-arrow left">◀</text>
        <text class="hint-text">左滑进入下一题</text>
        <text class="hint-arrow right">▶</text>
      </view>
      <view class="swipe-hint-row">
        <text class="hint-arrow right flip">◀</text>
        <text class="hint-text hint-sub">右滑返回上一题</text>
        <text class="hint-arrow left flip">▶</text>
      </view>
      <text class="hint-tap">轻触关闭</text>
    </view>
  </view>

</view>
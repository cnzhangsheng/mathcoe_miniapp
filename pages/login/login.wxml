<!--pages/login/login.wxml - 授权登录页面-->
<view class="login-container">
  <!-- 背景装饰 -->
  <view class="bg-decorator"></view>
  <view class="bg-decorator-2"></view>

  <!-- Logo 区域 -->
  <view class="logo-section">
    <view class="logo-box">
      <image class="logo-icon" src="{{imageBaseUrl + 'logo.png'}}" mode="aspectFit"></image>
    </view>
    <text class="app-name text-bold">小学数学思维</text>
    <text class="app-slogan text-small">Kangaroo Math Assistant</text>
    <text class="app-desc">您的 AI 数字化思维成长伙伴</text>
  </view>


  <!-- 登录区域 -->
  <view class="login-section">
    <!-- 年级选择 -->
    <view class="grade-section" bindtap="openGradePicker">
      <text class="grade-label text-small text-bold">选择年级</text>
      <view class="grade-picker">
        <text class="grade-value">{{grades[gradeIndex]}}</text>
        <text class="picker-arrow">›</text>
      </view>
    </view>

    <!-- 难度等级选择 -->
    <view class="grade-section" bindtap="openDifficultyPicker">
      <text class="grade-label text-small text-bold">难度等级</text>
      <view class="grade-picker">
        <text class="grade-value">{{difficultyLabels[difficultyLevel - 1].label}}</text>
        <text class="picker-arrow">›</text>
      </view>
    </view>

    <!-- 登录按钮 -->
    <button
      class="login-btn {{loading ? 'loading' : ''}}"
      bindtap="handleLogin"
      disabled="{{loading}}"
    >
      <view class="btn-content flex-row">
        <text class="btn-text text-bold">{{loading ? '登录中...' : '一键登录'}}</text>
      </view>
    </button>

    <!-- 隐私协议 -->
    <view class="privacy-section">
      <checkbox class="privacy-checkbox" checked="{{agreed}}" bindtap="onAgreementChange" />
      <text class="privacy-text">已阅读并同意</text>
      <text class="privacy-link" bindtap="onTapUserService">《用户服务协议》</text>
      <text class="privacy-text">和</text>
      <text class="privacy-link" bindtap="onTapPrivacy">《隐私政策》</text>
    </view>
  </view>

  <!-- 年级选择弹窗 -->
  <view wx:if="{{showGradePicker}}" class="picker-modal">
    <view class="picker-mask" bindtap="closeGradePicker"></view>
    <view class="picker-content">
      <view class="picker-header flex-between">
        <text class="picker-title text-bold">选择年级</text>
        <view class="picker-close" bindtap="closeGradePicker">
          <text>✕</text>
        </view>
      </view>
      <view class="picker-options">
        <block wx:for="{{grades}}" wx:key="*this">
          <view class="picker-option {{gradeIndex === index ? 'active' : ''}}" bindtap="selectGrade" data-index="{{index}}">
            <text class="option-text text-bold">{{item}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 难度等级选择弹窗 -->
  <view wx:if="{{showDifficultyPicker}}" class="picker-modal">
    <view class="picker-mask" bindtap="closeDifficultyPicker"></view>
    <view class="picker-content">
      <view class="picker-header flex-between">
        <text class="picker-title text-bold">选择难度等级</text>
        <view class="picker-close" bindtap="closeDifficultyPicker">
          <text>✕</text>
        </view>
      </view>
      <view class="picker-options">
        <block wx:for="{{difficultyLabels}}" wx:key="value">
          <view class="picker-option option-row {{difficultyLevel === item.value ? 'active' : ''}}" bindtap="selectDifficulty" data-level="{{item.value}}">
            <text class="option-text text-bold">{{item.label}}</text>
            <text class="option-hint">{{item.hint}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 温馨提示弹窗 -->
  <view wx:if="{{showAgreementModal}}" class="agreement-modal">
    <view class="agreement-mask" bindtap="onAgreementCancel"></view>
    <view class="agreement-content">
      <view class="agreement-header">
        <text class="agreement-title text-bold">温馨提示</text>
      </view>
      <view class="agreement-body">
        <text class="agreement-desc">已阅读并同意</text>
        <text class="agreement-link" bindtap="onTapUserService">《用户服务协议》</text>
        <text class="agreement-desc">和</text>
        <text class="agreement-link" bindtap="onTapPrivacy">《隐私政策》</text>
      </view>
      <view class="agreement-actions">
        <view class="agreement-btn agreement-btn-cancel" bindtap="onAgreementCancel">
          <text class="agreement-btn-text">不同意</text>
        </view>
        <view class="agreement-btn agreement-btn-confirm" bindtap="onAgreementConfirm">
          <text class="agreement-btn-text text-bold">同意</text>
        </view>
      </view>
    </view>
  </view>
</view>
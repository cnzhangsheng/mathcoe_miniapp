<!--pages/profile/profile.wxml - 我的页面（设置页面） -->
<view class="profile-page">

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-card">
      <view class="loading-icon-box">
        <text class="loading-icon">🔄</text>
      </view>
      <text class="loading-text text-small">正在加载...</text>
    </view>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 用户信息 -->
    <view class="user-card card">
      <view class="user-header flex-row">
        <view class="avatar-wrapper">
          <image class="user-avatar" src="{{imageBaseUrl + 'default-avatar.png'}}" mode="aspectFill"></image>
        </view>
        <view class="user-info">
          <text class="user-name text-bold">{{userInfo.nickname || '数学小达人'}}</text>
        </view>
      </view>
    </view>

    <!-- 学习数据 -->
    <view class="stats-card card">
      <view class="stats-header">
        <text class="stats-title text-bold">📊 学习数据</text>
      </view>
      <view class="stats-grid">
        <view class="stats-item">
          <text class="stats-value text-bold">{{statsDisplay.total}}</text>
          <text class="stats-label text-small">本周答题</text>
        </view>
        <view class="stats-item">
          <text class="stats-value text-bold">{{statsDisplay.rate}}</text>
          <text class="stats-label text-small">正确率</text>
        </view>
        <view class="stats-item">
          <text class="stats-value text-bold">{{statsDisplay.month_total}}</text>
          <text class="stats-label text-small">本月答题</text>
        </view>
      </view>
      <view class="stats-sub-row">
        <text class="stats-sub-item">正确/错题 <text class="stats-sub-val">{{statsDisplay.correct_wrong}}</text></text>
        <text class="stats-sub-item">收藏 <text class="stats-sub-val">{{statsDisplay.fav}}</text></text>
        <text class="stats-sub-item">累计错题 <text class="stats-sub-val">{{statsDisplay.total_wrong}}</text></text>
      </view>
    </view>

    <!-- 学习设置 -->
    <view class="section-card card">
      <view class="section-header">
        <text class="section-title text-bold">学习设置</text>
      </view>

      <view class="menu-item" bindtap="goToRecords">
        <view class="menu-left flex-row">
          <view class="menu-icon-box amber-bg">
            <text class="menu-icon">🏆</text>
          </view>
          <text class="menu-text">答题记录</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" bindtap="openGoalPicker">
        <view class="menu-left flex-row">
          <view class="menu-icon-box green-bg">
            <text class="menu-icon">🎯</text>
          </view>
          <text class="menu-text">每日目标</text>
        </view>
        <view class="menu-right flex-row">
          <text class="menu-value text-bold primary-color">{{dailyGoal}} 题</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="menu-item" bindtap="openGradePicker">
        <view class="menu-left flex-row">
          <view class="menu-icon-box purple-bg">
            <text class="menu-icon">📚</text>
          </view>
          <text class="menu-text">学习年级</text>
        </view>
        <view class="menu-right flex-row">
          <text class="menu-value text-bold">{{gradeLabels[gradeIndex].label}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="menu-item" bindtap="openDifficultyPicker">
        <view class="menu-left flex-row">
          <view class="menu-icon-box orange-bg">
            <text class="menu-icon">⭐</text>
          </view>
          <text class="menu-text">难度等级</text>
        </view>
        <view class="menu-right flex-row">
          <text class="menu-value text-bold">{{difficultyLabels[difficultyLevel - 1].label}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="menu-item" bindtap="goToFeedback">
        <view class="menu-left flex-row">
          <view class="menu-icon-box gray-bg">
            <text class="menu-icon">💬</text>
          </view>
          <text class="menu-text">意见反馈</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-btn" bindtap="logout">
      <text class="logout-text text-bold">退出登录</text>
    </view>

    </block>

  <!-- 每日目标选择弹窗 -->
  <view wx:if="{{showGoalPicker}}" class="picker-modal">
    <view class="picker-mask" bindtap="closeGoalPicker"></view>
    <view class="picker-content">
      <view class="picker-header flex-between">
        <text class="picker-title text-bold">选择每日目标</text>
        <view class="picker-close" bindtap="closeGoalPicker">
          <text>✕</text>
        </view>
      </view>
      <view class="picker-options">
        <view class="picker-option {{dailyGoal === 5 ? 'active' : ''}}" bindtap="setDailyGoal" data-goal="{{5}}">
          <text class="option-text text-bold">5 题/天</text>
          <text class="option-desc text-small text-muted">轻松入门</text>
        </view>
        <view class="picker-option {{dailyGoal === 12 ? 'active' : ''}}" bindtap="setDailyGoal" data-goal="{{12}}">
          <text class="option-text text-bold">12 题/天</text>
          <text class="option-desc text-small text-muted">推荐</text>
        </view>
        <view class="picker-option {{dailyGoal === 24 ? 'active' : ''}}" bindtap="setDailyGoal" data-goal="{{24}}">
          <text class="option-text text-bold">24 题/天</text>
          <text class="option-desc text-small text-muted">进阶提升</text>
        </view>
        <view class="picker-option {{dailyGoal === 48 ? 'active' : ''}}" bindtap="setDailyGoal" data-goal="{{48}}">
          <text class="option-text text-bold">48 题/天</text>
          <text class="option-desc text-small text-muted">冲刺满分</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 年级选择弹窗 -->
  <view wx:if="{{showGradePicker}}" class="picker-modal">
    <view class="picker-mask" bindtap="closeGradePicker"></view>
    <view class="picker-content">
      <view class="picker-header flex-between">
        <text class="picker-title text-bold">选择学习年级</text>
        <view class="picker-close" bindtap="closeGradePicker">
          <text>✕</text>
        </view>
      </view>
      <view class="picker-options">
        <block wx:for="{{gradeLabels}}" wx:key="value">
          <view class="picker-option {{gradeIndex === index ? 'active' : ''}}" bindtap="selectGrade" data-index="{{index}}">
            <text class="option-text text-bold">{{item.label}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 难度等级选择弹窗 -->
  <view wx:if="{{showDifficultyPicker}}" class="picker-modal">
    <view class="picker-mask" bindtap="closeDifficultyPicker"></view>
    <view class="picker-content">
      <view class="picker-header flex-between">
        <text class="picker-title text-bold">选择难度等级</text>
        <view class="picker-close" bindtap="closeDifficultyPicker">
          <text>✕</text>
        </view>
      </view>
      <view class="picker-options">
        <block wx:for="{{difficultyLabels}}" wx:key="value">
          <view class="picker-option {{difficultyLevel === item.value ? 'active' : ''}}" bindtap="selectDifficulty" data-level="{{item.value}}">
            <text class="option-text text-bold">{{item.label}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
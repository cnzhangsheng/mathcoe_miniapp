<!--pages/topic-question-detail/topic-question-detail.wxml - Swiper 滑动浏览-->
<view class="topic-detail-page">

  <!-- 无题目提示 -->
  <view class="empty-state" wx:if="{{noQuestions}}">
    <view class="empty-card">
      <view class="empty-icon-box">
        <text class="empty-icon">📚</text>
      </view>
      <text class="empty-title text-bold">该专题暂无题目</text>
      <text class="empty-sub text-small">请选择其他专题进行练习</text>
      <view class="empty-btn" bindtap="goBack">
        <text class="empty-btn-text text-bold">返回专题列表</text>
      </view>
    </view>
  </view>

  <!-- 完成全部题目提示 -->
  <view class="empty-state" wx:if="{{isCompleted}}">
    <view class="complete-card">
      <view class="complete-icon-box">
        <text class="complete-icon">🏆</text>
      </view>
      <text class="complete-title text-bold">恭喜完成全部题目！</text>
      <text class="complete-sub text-small">已完成 {{totalQuestions}} 道题目</text>
      <view class="complete-btn" bindtap="goBack">
        <text class="complete-btn-text text-bold">返回专题列表</text>
      </view>
    </view>
  </view>

  <!-- Swiper 滑动浏览 -->
  <block wx:if="{{!noQuestions && !isCompleted && swiperList.length > 0}}">
    <!-- 排序选择器（在 swiper 外部，全局生效） -->
    <view class="sort-bar">
      <view class="sort-trigger" bindtap="toggleSortPicker">
        <text class="sort-label">排序：</text>
        <text class="sort-value">
          <block wx:for="{{sortOptions}}" wx:key="value">
            <block wx:if="{{item.value === sortBy}}">{{item.label}}</block>
          </block>
        </text>
        <text class="sort-arrow">{{showSortPicker ? '▲' : '▼'}}</text>
      </view>
      <view class="sort-dropdown" wx:if="{{showSortPicker}}">
        <view
          class="sort-option {{item.value === sortBy ? 'sort-option-active' : ''}}"
          wx:for="{{sortOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="handleSortChange"
        >
          <text class="sort-option-text">{{item.label}}</text>
          <text class="sort-option-check" wx:if="{{item.value === sortBy}}">✓</text>
        </view>
      </view>
    </view>

    <!-- 进度指示 -->
    <view class="progress-row">
      <text class="progress-text">{{swiperCurrent + 1}} / {{totalQuestions}}</text>
    </view>

    <swiper current="{{swiperCurrent}}" duration="300" bindchange="onSwiperChange" class="topic-swiper">
      <swiper-item wx:for="{{swiperList}}" wx:for-item="card" wx:for-index="idx" wx:key="id">
        <scroll-view class="question-area" scroll-y>

          <!-- 题目信息 -->
          <view class="question-info-row">
            <text class="topic-badge {{topicClass}} text-small text-bold">{{topicTitle}}</text>
            <text class="difficulty-badge text-small text-bold" wx:if="{{card.questionLevel}}">{{card.questionLevel}}</text>
            <text class="question-type-badge text-small text-muted">（{{card.questionTypeText}}）</text>
          </view>

          <!-- Question Card -->
          <view class="question-card">
            <!-- 题目内容 -->
            <view class="question-content-box">
              <rich-text class="question-content" nodes="{{card.questionContentHtml || '题目内容'}}"></rich-text>
            </view>

            <!-- Question Image -->
            <view class="image-area" wx:if="{{card.question.content && card.question.content.images}}">
              <block wx:for="{{card.question.content.images}}" wx:key="*this">
                <image class="question-image" src="{{item}}" mode="aspectFit"></image>
              </block>
            </view>

            <!-- Options -->
            <view class="options-list">
              <block wx:for="{{card.options}}" wx:key="id">
                <view class="option-item {{card.selectedOption === item.id ? 'selected' : ''}} {{card.isSubmitted && card.correctAnswer === item.id ? 'correct' : ''}} {{card.isSubmitted && card.selectedOption === item.id && card.correctAnswer !== item.id ? 'wrong' : ''}}"
                  data-option="{{item.id}}" data-index="{{idx}}" bindtap="selectOption">
                  <view class="option-label-box {{card.selectedOption === item.id ? 'active' : ''}} {{card.isSubmitted && card.correctAnswer === item.id ? 'correct-label' : ''}} {{card.isSubmitted && card.selectedOption === item.id && card.correctAnswer !== item.id ? 'wrong-label' : ''}}">
                    <text class="option-label text-bold">{{item.id}}</text>
                  </view>
                  <rich-text class="option-text {{card.selectedOption === item.id ? 'active-text' : ''}}" nodes="{{item.labelHtml || item.label || ''}}"></rich-text>
                  <text class="option-status" wx:if="{{card.isSubmitted && card.correctAnswer === item.id}}">✓</text>
                  <text class="option-status wrong-status" wx:if="{{card.isSubmitted && card.selectedOption === item.id && card.correctAnswer !== item.id}}">✗</text>
                </view>
              </block>
            </view>
          </view>

          <!-- Action Bar: Like + Bookmark + Share -->
          <view class="action-icons-right">
            <view class="action-icon-btn {{card.isLiked ? 'liked' : ''}}" bindtap="toggleLike" data-index="{{idx}}">
              <image class="action-icon-img" src="{{card.isLiked ? '/assets/icons/icon_like_fill.png' : '/assets/icons/icon_like.png'}}" mode="aspectFit"></image>
              <text class="action-count">{{card.likeCount || 0}}</text>
            </view>
            <view class="action-icon-btn {{card.isBookmarked ? 'bookmarked' : ''}}" bindtap="toggleBookmark" data-index="{{idx}}">
              <image class="action-icon-img" src="{{card.isBookmarked ? '/assets/icons/icon_bookmark_fill.png' : '/assets/icons/icon_bookmark.png'}}" mode="aspectFit"></image>
              <text class="action-text">{{card.isBookmarked ? '已收藏' : '收藏'}}</text>
            </view>
            <button class="action-icon-btn share-btn" open-type="share" data-index="{{idx}}">
              <image class="action-icon-img" src="/assets/icons/icon_share.png" mode="aspectFit"></image>
              <text class="action-text">分享</text>
            </button>
          </view>

          <!-- Submit Button -->
          <view class="submit-row" wx:if="{{!card.isSubmitted && card.selectedOption}}">
            <view class="submit-answer-btn active" bindtap="handleSubmit" data-index="{{idx}}">
              <text class="submit-answer-text text-bold">提交答案</text>
            </view>
          </view>

          <!-- Analysis Section -->
          <view class="analysis-section" wx:if="{{card.isSubmitted}}">
            <view class="analysis-header flex-row">
              <text class="analysis-icon">💡</text>
              <text class="analysis-title text-small text-bold">答案解析</text>
            </view>
            <view class="analysis-card">
              <!-- Correct Answer -->
              <view class="answer-row flex-row">
                <view class="answer-box">
                  <text class="answer-letter text-bold">{{card.correctAnswer}}</text>
                </view>
                <view class="answer-info">
                  <text class="answer-title text-bold">正确答案：选项 {{card.correctAnswer}}</text>
                </view>
              </view>

              <!-- Logic -->
              <view class="logic-box">
                <text class="logic-label text-xs text-bold">解题思路</text>
                <text class="logic-text">{{card.analysis.logic}}</text>
              </view>

              <!-- Key Point -->
              <view class="key-point-box">
                <view class="key-icon-box">
                  <text class="key-icon">⭐</text>
                </view>
                <view class="key-content">
                  <text class="key-label text-xs text-bold">核心考点：</text>
                  <text class="key-text text-xs">{{card.analysis.point}}</text>
                </view>
              </view>
            </view>

            <!-- 左滑提示 -->
            <view class="swipe-next-row" wx:if="{{idx < totalQuestions - 1}}">
              <text class="swipe-next-text">◀ 左滑进入下一题</text>
            </view>
            <view class="swipe-next-row" wx:if="{{idx >= totalQuestions - 1}}">
              <view class="complete-swipe-btn" bindtap="goBack">
                <text class="complete-btn-text text-bold">完成并返回</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </swiper-item>
    </swiper>
  </block>

  <!-- 图片预加载 -->
  <block wx:if="{{preloadedImageUrls.length > 0}}">
    <image wx:for="{{preloadedImageUrls}}" wx:key="*this" src="{{item}}" style="display:none;" />
  </block>
</view>

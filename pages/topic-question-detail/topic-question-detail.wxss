/* pages/topic-question-detail/topic-question-detail.wxss - Swiper 滑动浏览 */
@import "../../styles/practice-common.wxss";

page {
  height: 100%;
  overflow: hidden;
}

.topic-detail-page {
  height: 100%;
  background-color: #f8f8f8;
  padding: 16rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* Empty State */
.empty-state {
  min-height: calc(100vh - 32rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-card, .complete-card {
  background-color: #fff;
  border-radius: 64rpx;
  padding: 80rpx 64rpx;
  text-align: center;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
  max-width: 600rpx;
}

.empty-icon-box, .complete-icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: rgba(99, 102, 241, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 48rpx;
}

.complete-icon-box {
  background-color: rgba(16, 185, 129, 0.1);
}

.empty-icon, .complete-icon {
  font-size: 80rpx;
}

.empty-title, .complete-title {
  font-size: 36rpx;
  color: rgba(0, 0, 0, 0.9);
  margin-bottom: 16rpx;
}

.empty-sub, .complete-sub {
  color: rgba(0, 0, 0, 0.5);
  margin-bottom: 80rpx;
}

.empty-btn, .complete-btn {
  padding: 32rpx 64rpx;
  background-color: #07C160;
  color: #fff;
  border-radius: 48rpx;
  display: inline-block;
  box-shadow: 0 16rpx 32rpx rgba(7, 193, 96, 0.2);
}

.complete-btn {
  background-color: #000;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.2);
}

.empty-btn-text, .complete-btn-text {
  font-size: 28rpx;
}

/* Sort Bar */
.sort-bar {
  position: relative;
  margin-bottom: 12rpx;
  z-index: 10;
  flex-shrink: 0;
}

.sort-trigger {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background-color: #fff;
  border-radius: 24rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.sort-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
}

.sort-value {
  flex: 1;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.8);
  font-weight: 600;
}

.sort-arrow {
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.3);
}

.sort-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  margin-top: 8rpx;
  background-color: #fff;
  border-radius: 24rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.sort-option {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.03);
}

.sort-option:last-child {
  border-bottom: none;
}

.sort-option-active {
  background-color: rgba(99, 102, 241, 0.05);
}

.sort-option-text {
  flex: 1;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.8);
}

.sort-option-active .sort-option-text {
  color: #6366F1;
  font-weight: 600;
}

.sort-option-check {
  font-size: 28rpx;
  color: #6366F1;
  font-weight: 700;
}

/* Progress Row */
.progress-row {
  text-align: center;
  margin-bottom: 8rpx;
  flex-shrink: 0;
}

.progress-text {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
  font-weight: 600;
}

/* Swiper */
.topic-swiper {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.question-area {
  height: 100%;
  padding: 8rpx 4rpx 32rpx;
  box-sizing: border-box;
}

/* Question Info Row */
.question-info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.topic-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.topic-badge.topic-yunsuan {
  background-color: #FFF0D6;
  color: #FF8A00;
}

.topic-badge.topic-luoji {
  background-color: #DCFFE4;
  color: #10B981;
}

.topic-badge.topic-tuxing {
  background-color: #FFE8EC;
  color: #FF6B8A;
}

.topic-badge.topic-yingyong {
  background-color: #E0F7E9;
  color: #38D9A9;
}

.topic-badge.topic-default {
  background-color: #FFF5F5;
  color: #FF8787;
}

.difficulty-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background-color: #FEF3C7;
  color: #D97706;
}

.question-type-badge {
  color: rgba(0, 0, 0, 0.5);
}

/* Question Card */
.question-card {
  background-color: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.question-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.question-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.question-title {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.85);
}

.question-count {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.5);
}

.question-type-text {
  color: rgba(0, 0, 0, 0.5);
}

.question-content-box {
  margin-bottom: 32rpx;
}

.question-content {
  font-size: 36rpx;
  color: rgba(0, 0, 0, 0.9);
  line-height: 1.6;
}

.question-content p {
  margin: 0;
  line-height: 1.6;
}

/* Image Area */
.image-area {
  background-color: rgba(0, 0, 0, 0.02);
  border-radius: 48rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.question-image {
  width: 100%;
  max-height: 400rpx;
  border-radius: 32rpx;
}


.answer-sub {
  color: #07C160;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}

/* Swipe Next Hint */
.swipe-next-row {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
}

.complete-swipe-btn {
  padding: 24rpx 64rpx;
  background-color: #07C160;
  color: #fff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(7, 193, 96, 0.2);
}

/* Utility Classes */
.flex-row {
  display: flex;
  align-items: center;
}

.text-bold {
  font-weight: 900;
}

.text-small {
  font-size: 24rpx;
}


.generate-page {
  min-height: 100vh;
  background-color: #f8f8f8;
  display: flex;
  flex-direction: column;
}

.form-scroll {
  flex: 1;
  padding-top: 24rpx;
}

.form-section {
  margin: 0 32rpx 32rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  border: 2rpx solid rgba(0,0,0,0.05);
}

.section-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.label-text {
  font-size: 30rpx;
  color: rgba(0,0,0,0.9);
}

.label-hint {
  font-size: 24rpx;
  color: rgba(0,0,0,0.4);
}

.title-input {
  width: 100%;
  height: 80rpx;
  background-color: rgba(0,0,0,0.03);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: rgba(0,0,0,0.9);
  box-sizing: border-box;
}

.topic-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-chip {
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.topic-chip-selected {
  background-color: #07C160;
  border-color: #07C160;
}

.topic-chip-text {
  font-size: 26rpx;
  color: rgba(0,0,0,0.7);
}

.topic-chip-selected .topic-chip-text {
  color: #fff;
  font-weight: 600;
}

.topic-chip-check {
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
}

.difficulty-row {
  display: flex;
  gap: 16rpx;
}

.difficulty-item {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.difficulty-item-active {
  background-color: #07C160;
  border-color: #07C160;
}

.difficulty-text {
  font-size: 28rpx;
  color: rgba(0,0,0,0.6);
  font-weight: 600;
}

.difficulty-text-active {
  color: #fff;
}

.count-row {
  display: flex;
  gap: 16rpx;
}

.count-item {
  flex: 1;
  height: 80rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.count-item-active {
  background-color: #07C160;
  border-color: #07C160;
}

.count-item-text {
  font-size: 28rpx;
  color: rgba(0,0,0,0.6);
  font-weight: 600;
}

.count-item-text-active {
  color: #fff;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 48rpx;
  background: #fff;
  border-top: 2rpx solid rgba(0,0,0,0.05);
}

.generate-btn {
  height: 96rpx;
  background-color: #07C160;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(7,193,96,0.3);
}

.generate-btn-disabled {
  opacity: 0.6;
}

.generate-btn-text {
  font-size: 32rpx;
  color: #fff;
  letter-spacing: 8rpx;
}

<view class="generate-page">
  <scroll-view class="form-scroll" scroll-y>

    <!-- Paper Title -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-text text-bold">考卷标题</text>
        <text class="label-hint">（必填，最多50字）</text>
      </view>
      <input class="title-input" type="text" placeholder="输入考卷标题" value="{{title}}" maxlength="50" bindinput="onTitleInput" />
    </view>

    <!-- Topic Selection -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-text text-bold">选择专题</text>
        <text class="label-hint">（可多选）</text>
      </view>
      <view class="topic-grid">
        <view
          wx:for="{{topics}}"
          wx:key="id"
          class="topic-chip {{selectedTopicSet[item.id] ? 'topic-chip-selected' : ''}}"
          data-id="{{item.id}}"
          catchtap="toggleTopic"
        >
          <text class="topic-chip-text">{{item.title}}</text>
        </view>
      </view>
    </view>

    <!-- Difficulty Selection -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-text text-bold">难度等级</text>
      </view>
      <view class="difficulty-row">
        <view
          wx:for="{{difficultyOptions}}"
          wx:key="value"
          class="difficulty-item {{difficultyLevel === item.value ? 'difficulty-item-active' : ''}}"
          data-level="{{item.value}}"
          bindtap="selectDifficulty"
        >
          <text class="difficulty-text {{difficultyLevel === item.value ? 'difficulty-text-active' : ''}}">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- Question Count -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-text text-bold">题目数量</text>
      </view>
      <view class="count-row">
        <view
          wx:for="{{[5,12,24,48]}}"
          wx:key="*this"
          class="count-item {{questionCount === item ? 'count-item-active' : ''}}"
          data-count="{{item}}"
          bindtap="selectQuestionCount"
        >
          <text class="count-item-text {{questionCount === item ? 'count-item-text-active' : ''}}">{{item}}题</text>
        </view>
      </view>
    </view>

    <!-- Include Wrong & Favorite -->
    <view class="form-section">
      <view class="section-label">
        <text class="label-text text-bold">题目包含</text>
        <text class="label-hint">（可多选）</text>
      </view>
      <view class="include-row">
        <view
          class="include-chip {{wrongSelected ? 'include-chip-selected include-chip-wrong' : ''}}"
          catchtap="toggleWrong"
        >
          <text class="include-chip-text {{wrongSelected ? 'include-chip-text-selected' : ''}}">错题</text>
        </view>
        <view
          class="include-chip {{favoriteSelected ? 'include-chip-selected include-chip-favorite' : ''}}"
          catchtap="toggleFavorite"
        >
          <text class="include-chip-text {{favoriteSelected ? 'include-chip-text-selected' : ''}}">收藏</text>
        </view>
      </view>
    </view>

    <view style="height: 160rpx;"></view>
  </scroll-view>

  <!-- Generate Button -->
  <view class="bottom-bar">
    <view class="generate-btn {{generating ? 'generate-btn-disabled' : ''}}" bindtap="generatePaper">
      <text class="generate-btn-text text-bold">{{generating ? '生成中...' : '生成考卷'}}</text>
    </view>
  </view>

  <!-- 生成成功弹窗 -->
  <view class="result-overlay" wx:if="{{showResult}}">
    <view class="result-dialog">
      <view class="result-header">
        <text class="result-icon">🎉</text>
        <text class="result-title text-bold">考卷生成成功！</text>
      </view>
      <view class="result-info">
        <view class="result-row">
          <text class="result-label">考卷标题</text>
          <text class="result-value text-bold">{{resultPaper.title}}</text>
        </view>
        <view class="result-divider"></view>
        <view class="result-row">
          <text class="result-label">题目总数</text>
          <text class="result-value text-bold">{{resultPaper.total_questions}}题</text>
        </view>
        <block wx:for="{{resultPaper.topic_question_counts}}" wx:key="topic_id">
          <view class="result-divider"></view>
          <view class="result-row">
            <text class="result-label">{{item.topic_title}}</text>
            <text class="result-value text-bold">{{item.count}}题</text>
          </view>
        </block>
      </view>
      <view class="result-guide">
        <text class="result-guide-text text-small">前往首页「我的考卷」即可查看和答题</text>
      </view>
      <view class="result-buttons">
        <view class="result-btn result-btn-primary" bindtap="goToMyPapers">
          <text class="result-btn-text text-bold">查看我的考卷</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 生成失败弹窗 -->
  <view class="result-overlay" wx:if="{{showError}}">
    <view class="result-dialog">
      <view class="result-header">
        <text class="result-icon">😅</text>
        <text class="result-title text-bold">生成失败</text>
      </view>
      <view class="result-guide" style="margin-bottom: 32rpx;">
        <text class="result-guide-text text-small">{{errorMsg}}</text>
      </view>
      <view class="result-buttons">
        <view class="result-btn result-btn-primary" bindtap="closeError">
          <text class="result-btn-text text-bold">知道了</text>
        </view>
      </view>
    </view>
  </view>
</view>

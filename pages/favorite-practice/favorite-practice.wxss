/* pages/favorite-practice/favorite-practice.wxss - 收藏练习页面样式 */
@import "../../styles/practice-common.wxss";

.practice-page {
  padding: 32rpx;
  padding-bottom: 120rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

/* Loading State */
.loading-state {
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx;
  background-color: #fff;
  border-radius: 32rpx;
}

.loading-icon {
  font-size: 48rpx;
}

.loading-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.4);
}

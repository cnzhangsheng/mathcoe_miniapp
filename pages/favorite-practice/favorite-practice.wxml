<!--pages/favorite-practice/favorite-practice.wxml - 收藏练习页面 -->
<view class="practice-page">

  <!-- 练习内容 -->
  <block wx:if="{{!loading && currentQuestion}}">
    <!-- Question Card -->
    <view class="question-card">
      <!-- 题目信息 -->
      <view class="question-info-row">
        <text class="topic-badge {{topicClass}} text-small text-bold">{{topicTitle}}</text>
        <text class="difficulty-badge text-small text-bold" wx:if="{{questionLevel}}">{{questionLevel}}</text>
        <text class="question-type-badge text-small text-muted">（{{questionType}}）</text>
      </view>
      <view class="question-content-box">
        <rich-text class="question-content" nodes="{{currentQuestion.content || '题目内容'}}"></rich-text>
      </view>

      <!-- Options -->
      <view class="options-list">
        <block wx:for="{{currentQuestion.options}}" wx:key="key">
          <view class="option-item {{selectedAnswer === item.key ? 'selected' : ''}} {{showResult && item.key === currentQuestion.answer ? 'correct' : ''}} {{showResult && selectedAnswer === item.key && selectedAnswer !== currentQuestion.answer ? 'wrong' : ''}}"
                bindtap="selectOption"
                data-key="{{item.key}}">
            <view class="option-label-box {{selectedAnswer === item.key ? 'active' : ''}} {{showResult && item.key === currentQuestion.answer ? 'correct-label' : ''}} {{showResult && selectedAnswer === item.key && selectedAnswer !== currentQuestion.answer ? 'wrong-label' : ''}}">
              <text class="option-label text-bold">{{item.key}}</text>
            </view>
            <rich-text class="option-text {{selectedAnswer === item.key ? 'active-text' : ''}}" nodes="{{item.value}}"></rich-text>
            <text class="option-status" wx:if="{{showResult && item.key === currentQuestion.answer}}">✓</text>
            <text class="option-status wrong-status" wx:if="{{showResult && selectedAnswer === item.key && selectedAnswer !== currentQuestion.answer}}">✗</text>
          </view>
        </block>
      </view>
    </view>

    <!-- Action Bar: Bookmark + Share -->
    <view class="action-icons-right">
      <view class="action-icon-btn {{isFavorited ? 'bookmarked' : ''}}" bindtap="toggleFavorite">
        <image class="action-icon-img" src="{{isFavorited ? (imageBaseUrl + 'icons/icon_bookmark_fill.png') : (imageBaseUrl + 'icons/icon_bookmark.png')}}" mode="aspectFit"></image>
        <text class="action-text">{{isFavorited ? '已收藏' : '收藏'}}</text>
      </view>
      <button wx:if="{{isLoggedIn}}" class="action-icon-btn share-btn" open-type="share">
        <image class="action-icon-img" src="{{imageBaseUrl + 'icons/icon_share.png'}}" mode="aspectFit"></image>
        <text class="action-text">分享</text>
      </button>
      <view wx:else class="action-icon-btn share-btn" bindtap="goToLogin">
        <image class="action-icon-img" src="{{imageBaseUrl + 'icons/icon_share.png'}}" mode="aspectFit"></image>
        <text class="action-text">分享</text>
      </view>
      <view class="action-icon-btn" bindtap="downloadImage">
        <image class="action-icon-img" src="{{imageBaseUrl + 'icons/icon_image.png'}}" mode="aspectFit"></image>
        <text class="action-text">图片</text>
      </view>
    </view>

    <!-- Submit Button -->
    <view class="submit-row" wx:if="{{!showResult}}">
      <view class="submit-answer-btn {{selectedAnswer ? 'active' : ''}}" bindtap="submitAnswer">
        <text class="submit-answer-text text-bold">提交答案</text>
      </view>
    </view>

    <!-- Analysis Section -->
    <view class="analysis-section" wx:if="{{showResult}}">
      <view class="analysis-card">
        <!-- Correct Answer -->
        <view class="answer-row flex-row">
          <view class="answer-box">
            <text class="answer-letter text-bold">{{currentQuestion.answer}}</text>
          </view>
          <view class="answer-info">
            <text class="answer-title text-bold">正确答案：{{currentQuestion.answer}}</text>
          </view>
        </view>

        <!-- Explanation -->
        <view class="logic-box">
          <text class="logic-label text-xs text-bold">题目解析</text>
          <rich-text class="logic-text" nodes="{{currentQuestion.explanation}}"></rich-text>
        </view>
      </view>

      <!-- Back to Favorites -->
      <view class="next-row">
        <view class="next-btn" bindtap="goHome">
          <text class="next-btn-text text-bold">返回收藏夹</text>
        </view>
      </view>
    </view>
  </block>

  <!-- Hidden canvas for download image -->
  <canvas type="2d" id="questionCanvas" style="width:375px;height:600px;position:fixed;left:-9999px;top:0;z-index:-1;"></canvas>
</view>

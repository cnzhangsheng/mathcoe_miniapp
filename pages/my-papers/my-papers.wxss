.my-papers-page {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 16rpx 32rpx;
}

.empty-state {
  min-height: calc(100vh - 100rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-card {
  text-align: center;
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: rgba(99,102,241,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  font-size: 32rpx;
  margin-bottom: 16rpx;
}

.empty-sub {
  color: rgba(0,0,0,0.5);
  margin-bottom: 48rpx;
}

.paper-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 2rpx solid rgba(0,0,0,0.05);
}

.paper-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background-color: rgba(99,102,241,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.paper-icon {
  font-size: 40rpx;
}

.paper-middle {
  flex: 1;
}

.paper-title {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.paper-meta-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.paper-meta {
  font-size: 24rpx;
  color: rgba(0,0,0,0.5);
}

.score-text {
  font-size: 24rpx;
  color: #10B981;
  font-weight: 600;
}

.status-text {
  font-size: 24rpx;
  color: rgba(0,0,0,0.35);
}

.arrow-icon {
  font-size: 40rpx;
  color: rgba(0,0,0,0.2);
}

.load-more, .loading-more {
  text-align: center;
  padding: 32rpx;
}

.load-more-text, .loading-text {
  font-size: 26rpx;
  color: rgba(0,0,0,0.4);
}

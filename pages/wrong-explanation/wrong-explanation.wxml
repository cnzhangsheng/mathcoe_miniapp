<!-- pages/wrong-explanation/wrong-explanation.wxml - 错题解析页面 -->
<view class="explanation-page">
  <!-- 题目卡片 -->
  <view class="question-card card">
    <view class="card-header flex-between">
      <view class="header-left flex-row">
        <view class="topic-badge {{topicClass}}">
          <text class="topic-text text-small text-bold">{{topicTitle}}</text>
        </view>
        <text class="difficulty-badge text-small text-bold" wx:if="{{questionLevel}}">{{questionLevel}}</text>
        <text class="date-text text-small text-muted">{{dateLabel}}</text>
      </view>
      <view class="remove-btn" bindtap="removeQuestion">
        <text class="remove-icon">✕</text>
      </view>
    </view>

    <view class="question-content-box">
      <rich-text class="question-content" nodes="{{content}}"></rich-text>
    </view>

    <!-- 选项列表 -->
    <view class="options-list">
      <block wx:for="{{options}}" wx:key="key">
        <view class="option-item {{item.key === correctAnswer ? 'correct' : ''}} {{item.key === userAnswer && item.key !== correctAnswer ? 'wrong' : ''}}">
          <view class="option-label-box {{item.key === correctAnswer ? 'correct-label' : ''}} {{item.key === userAnswer && item.key !== correctAnswer ? 'wrong-label' : ''}}">
            <text class="option-label text-bold">{{item.key}}</text>
          </view>
          <rich-text class="option-text" nodes="{{item.value}}"></rich-text>
          <text class="option-status" wx:if="{{item.key === correctAnswer}}">✓</text>
          <text class="option-status wrong-status" wx:if="{{item.key === userAnswer && item.key !== correctAnswer}}">✗</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 收藏 + 分享 -->
  <view class="action-icons-right">
    <view class="action-icon-btn {{isFavorited ? 'bookmarked' : ''}}" bindtap="toggleFavorite">
      <image class="action-icon-img" src="{{isFavorited ? (imageBaseUrl + 'icons/icon_bookmark_fill.png') : (imageBaseUrl + 'icons/icon_bookmark.png')}}" mode="aspectFit"></image>
      <text class="action-text">{{isFavorited ? '已收藏' : '收藏'}}</text>
    </view>
    <button wx:if="{{isLoggedIn}}" class="action-icon-btn share-btn" open-type="share">
      <image class="action-icon-img" src="{{imageBaseUrl + 'icons/icon_share.png'}}" mode="aspectFit"></image>
      <text class="action-text">分享</text>
    </button>
    <view wx:else class="action-icon-btn share-btn" bindtap="goToLogin">
      <image class="action-icon-img" src="{{imageBaseUrl + 'icons/icon_share.png'}}" mode="aspectFit"></image>
      <text class="action-text">分享</text>
    </view>
    <view class="action-icon-btn" bindtap="downloadImage">
      <image class="action-icon-img" src="{{imageBaseUrl + 'icons/icon_image.png'}}" mode="aspectFit"></image>
      <text class="action-text">图片</text>
    </view>
  </view>

  <!-- 答案解析 -->
  <view class="analysis-section">
    <view class="analysis-card">
      <!-- 你的答案 -->
      <view class="answer-row flex-row">
        <view class="answer-box" style="background-color: #F43F5E;">
          <text class="answer-letter text-bold">{{userAnswer || '?'}}</text>
        </view>
        <view class="answer-info">
          <text class="answer-title text-bold">你的答案：{{userAnswer || '未作答'}}</text>
        </view>
      </view>

      <!-- Correct Answer -->
      <view class="answer-row flex-row">
        <view class="answer-box">
          <text class="answer-letter text-bold">{{correctAnswer}}</text>
        </view>
        <view class="answer-info">
          <text class="answer-title text-bold">正确答案：{{correctAnswer}}</text>
        </view>
      </view>

      <!-- Explanation -->
      <view class="logic-box">
        <text class="logic-label text-xs text-bold">题目解析</text>
        <rich-text class="logic-text" nodes="{{explanation}}"></rich-text>
      </view>
    </view>
  </view>

  <!-- Hidden canvas for download image -->
  <canvas type="2d" id="questionCanvas" style="width:375px;height:600px;position:fixed;left:-9999px;top:0;z-index:-1;"></canvas>
</view>
/* pages/wrong-explanation/wrong-explanation.wxss - 错题解析页面样式 */
@import "../../styles/practice-common.wxss";

.explanation-page {
  padding: 20rpx;
  padding-bottom: 120rpx;
  background-color: #F8F8F8;
  min-height: 100vh;
}

/* Card */
.card {
  background-color: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

/* Question Card */
.question-card {
  padding: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.topic-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.topic-badge.topic-yunsuan { background-color: #FFF0D6; }
.topic-badge.topic-yunsuan .topic-text { color: #FF8A00; }
.topic-badge.topic-luoji { background-color: #DCFFE4; }
.topic-badge.topic-luoji .topic-text { color: #10B981; }
.topic-badge.topic-tuxing { background-color: #FFE8EC; }
.topic-badge.topic-tuxing .topic-text { color: #FF6B8A; }
.topic-badge.topic-yingyong { background-color: #E0F7E9; }
.topic-badge.topic-yingyong .topic-text { color: #38D9A9; }
.topic-badge.topic-default { background-color: #FFF5F5; }
.topic-badge.topic-default .topic-text { color: #FF8787; }

.date-text {
  color: rgba(0, 0, 0, 0.4);
}

.difficulty-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background-color: #FEF3C7;
  color: #D97706;
}

.remove-btn {
  padding: 8rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
}

.question-content-box {
  margin-bottom: 24rpx;
}

.question-content {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.85);
  line-height: 1.6;
}

/* Action Bar */
.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
}

.retry-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 24rpx;
  background-color: #07C160;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.2);
}

.retry-text {
  font-size: 28rpx;
  color: #fff;
}


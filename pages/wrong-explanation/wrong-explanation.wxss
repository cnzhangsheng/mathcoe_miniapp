/* pages/wrong-explanation/wrong-explanation.wxss - 错题解析页面样式 */

.explanation-page {
  padding: 20rpx;
  padding-bottom: 120rpx;
  background-color: #F8F8F8;
  min-height: 100vh;
}

/* Card */
.card {
  background-color: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

/* Question Card */
.question-card {
  padding: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.topic-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.topic-badge.topic-yunsuan { background-color: #FFF0D6; }
.topic-badge.topic-yunsuan .topic-text { color: #FF8A00; }
.topic-badge.topic-luoji { background-color: #DCFFE4; }
.topic-badge.topic-luoji .topic-text { color: #10B981; }
.topic-badge.topic-tuxing { background-color: #FFE8EC; }
.topic-badge.topic-tuxing .topic-text { color: #FF6B8A; }
.topic-badge.topic-yingyong { background-color: #E0F7E9; }
.topic-badge.topic-yingyong .topic-text { color: #38D9A9; }
.topic-badge.topic-default { background-color: #FFF5F5; }
.topic-badge.topic-default .topic-text { color: #FF8787; }

.date-text {
  color: rgba(0, 0, 0, 0.4);
}

.difficulty-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background-color: #FEF3C7;
  color: #D97706;
}

.remove-btn {
  padding: 8rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
}

.question-content-box {
  margin-bottom: 24rpx;
}

.question-content {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.85);
  line-height: 1.6;
}

/* Options List */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 32rpx 48rpx;
  border-radius: 48rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.03);
  background-color: #fff;
}

.option-item.correct {
  background-color: rgba(16, 185, 129, 0.1);
  border-color: #10B981;
  box-shadow: 0 8rpx 16rpx rgba(16, 185, 129, 0.1);
}

.option-item.wrong {
  background-color: rgba(244, 63, 94, 0.1);
  border-color: #F43F5E;
  box-shadow: 0 8rpx 16rpx rgba(244, 63, 94, 0.1);
}

.option-label-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.05);
}

.option-label-box.correct-label {
  background-color: #10B981;
}

.option-label-box.wrong-label {
  background-color: #F43F5E;
}

.option-label {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.85);
}

.option-label-box.correct-label .option-label,
.option-label-box.wrong-label .option-label {
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.85);
  line-height: 1.5;
}

.option-text p {
  margin: 0;
  line-height: 1.5;
}

.option-item.correct .option-text,
.option-item.wrong .option-text {
  color: rgba(0, 0, 0, 0.8);
}

.option-status {
  margin-left: auto;
  font-size: 40rpx;
  color: #10B981;
}

.option-status.wrong-status {
  color: #F43F5E;
}

/* Result Card */
.result-card {
  padding: 24rpx;
}

.result-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.result-header.success {
  background-color: #D1FAE5;
}

.result-header.error {
  background-color: #FEE2E2;
}

.result-icon {
  font-size: 24rpx;
}

.result-header.success .result-text {
  color: #10B981;
}

.result-header.error .result-text {
  color: #EF4444;
}

.answer-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.answer-row {
  display: flex;
  align-items: center;
}

.answer-label {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.5);
}

.answer-value {
  font-size: 28rpx;
}

.answer-value.correct {
  color: #10B981;
}

.answer-value.wrong {
  color: #EF4444;
}

/* Explanation Card */
.explanation-card {
  padding: 24rpx;
}

.explanation-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.explanation-icon {
  font-size: 28rpx;
}

.explanation-title {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.85);
}

.explanation-content {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.7);
  line-height: 1.6;
}

/* Action Bar */
.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
}

.retry-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 24rpx;
  background-color: #07C160;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.2);
}

.retry-text {
  font-size: 28rpx;
  color: #fff;
}

/* Action Icons - matching discover page */
.action-icons-right {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
  padding-right: 32rpx;
}

.action-icon-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  background-color: rgba(0, 0, 0, 0.03);
}

.action-icon-btn.bookmarked {
  background-color: rgba(251, 191, 36, 0.1);
}

.action-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.action-text {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
}

.share-btn {
  padding: 16rpx 24rpx;
  margin: 0;
  border: none;
  background-color: rgba(0, 0, 0, 0.03);
  line-height: normal;
  min-height: 0;
  box-sizing: border-box;
}

.share-btn::after {
  border: none;
}

.action-icon-btn.bookmarked .action-text {
  color: #F59E0B;
}

/* Utility */
.text-bold {
  font-weight: 700;
}

.text-small {
  font-size: 24rpx;
}

.text-muted {
  color: rgba(0, 0, 0, 0.4);
}

.flex-row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
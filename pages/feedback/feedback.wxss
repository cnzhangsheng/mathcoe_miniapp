/* pages/feedback/feedback.wxss */
page {
  background-color: #F8F8F8;
}

.feedback-page {
  padding: 40rpx 20rpx;
  min-height: 100vh;
}

.card {
  background-color: #fff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.form-card {
  overflow: hidden;
}

.form-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
}

.form-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: rgba(99, 102, 241, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.form-icon-box text {
  font-size: 40rpx;
}

.form-title {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.9);
  margin-bottom: 8rpx;
}

.form-sub {
  color: rgba(0, 0, 0, 0.4);
}

.form-body {
  padding: 0 32rpx 32rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.8);
  display: block;
  margin-bottom: 16rpx;
}

.required {
  color: #EF4444;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 28rpx 32rpx;
  background-color: rgba(0, 0, 0, 0.03);
  border-radius: 24rpx;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.85);
  box-sizing: border-box;
  line-height: 1.6;
}

.form-textarea::placeholder {
  color: rgba(0, 0, 0, 0.25);
}

.form-count {
  display: block;
  text-align: right;
  margin-top: 8rpx;
  color: rgba(0, 0, 0, 0.3);
}

.form-input {
  width: 100%;
  padding: 32rpx 32rpx;
  min-height: 96rpx;
  background-color: rgba(0, 0, 0, 0.03);
  border-radius: 24rpx;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.85);
  box-sizing: border-box;
}

.form-input::placeholder {
  color: rgba(0, 0, 0, 0.25);
}

.form-actions {
  padding: 16rpx 32rpx 40rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #07C160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  text-align: center;
}

.submit-btn[disabled] {
  opacity: 0.6;
}
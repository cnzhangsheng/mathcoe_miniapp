/* pages/question-bank/question-detail/question-detail.wxss */
@import "../../../styles/practice-common.wxss";

.detail-page {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* Loading */
.loading-state {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-card {
  background-color: #fff;
  border-radius: 64rpx;
  padding: 80rpx 64rpx;
  text-align: center;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.loading-icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: rgba(99, 102, 241, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 48rpx;
}

.loading-icon {
  font-size: 80rpx;
}

.loading-text {
  color: rgba(0, 0, 0, 0.5);
  font-size: 28rpx;
}

/* Scroll */
.detail-scroll {
  height: calc(100vh - 120rpx);
  padding: 24rpx 4rpx 32rpx;
  box-sizing: border-box;
}

/* Question Card */
.question-card {
  background-color: #fff;
  border-radius: 64rpx;
  padding: 48rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.question-info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.topic-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.topic-badge.topic-yunsuan {
  background-color: #FFF0D6;
  color: #FF8A00;
}

.topic-badge.topic-luoji {
  background-color: #DCFFE4;
  color: #10B981;
}

.topic-badge.topic-tuxing {
  background-color: #FFE8EC;
  color: #FF6B8A;
}

.topic-badge.topic-yingyong {
  background-color: #E0F7E9;
  color: #38D9A9;
}

.topic-badge.topic-default {
  background-color: #FFF5F5;
  color: #FF8787;
}

.difficulty-badge {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background-color: #FEF3C7;
  color: #D97706;
  font-size: 24rpx;
}

.question-type-badge {
  color: rgba(0, 0, 0, 0.5);
  font-size: 24rpx;
}

.question-content-box {
  margin-bottom: 32rpx;
}

.question-content {
  font-size: 36rpx;
  color: rgba(0, 0, 0, 0.9);
  line-height: 1.6;
}

.question-content p {
  margin: 0;
  line-height: 1.6;
}

/* Action Icons */
.action-icons-right {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  padding: 24rpx 0;
}

.action-icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.action-icon-btn.share-btn {
  background: #fff;
  border: none;
  line-height: 1;
  padding: 16rpx 24rpx;
}
.action-icon-btn.share-btn::after {
  border: none;
}

.action-icon-btn.bookmarked {
  background-color: rgba(99, 102, 241, 0.08);
}

.action-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.action-text {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.5);
}

/* Submit Row */
.submit-row {
  padding: 16rpx 0 8rpx;
}

.submit-answer-btn {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 48rpx;
  background-color: rgba(0, 0, 0, 0.04);
  text-align: center;
  transition: all 0.2s;
}

.submit-answer-btn.active {
  background-color: #10B981;
  box-shadow: 0 16rpx 32rpx rgba(16, 185, 129, 0.2);
}

.submit-answer-text {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.3);
}

.submit-answer-btn.active .submit-answer-text {
  color: #fff;
}

/* Analysis Section */
.analysis-section {
  padding-bottom: 48rpx;
}

.analysis-card {
  background-color: #fff;
  border-radius: 48rpx;
  padding: 32rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
  margin-top: 24rpx;
}

.answer-row {
  margin-bottom: 24rpx;
}

.answer-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 32rpx;
  background-color: #10B981;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.answer-letter {
  font-size: 32rpx;
  color: #fff;
}

.answer-title {
  font-size: 30rpx;
  color: #10B981;
}

.logic-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
  margin-bottom: 16rpx;
  display: block;
}

.logic-text {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.75);
  line-height: 1.6;
}

.logic-text p {
  margin: 0;
  line-height: 1.6;
}

/* Empty State */
.empty-state {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-card {
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.5);
  margin-bottom: 32rpx;
}

.back-btn {
  padding: 24rpx 48rpx;
  background-color: #07C160;
  border-radius: 48rpx;
  display: inline-block;
}

.back-btn-text {
  color: #fff;
  font-size: 28rpx;
}

/* Utility */
.flex-row {
  display: flex;
  align-items: center;
}

.text-bold {
  font-weight: 900;
}

.text-small {
  font-size: 24rpx;
}

.text-xs {
  font-size: 22rpx;
}

/* Option status marks */
.option-status {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #10B981;
  font-weight: 700;
}

.option-status.wrong-status {
  color: #F43F5E;
}